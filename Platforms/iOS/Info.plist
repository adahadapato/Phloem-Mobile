<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Phloem uses your photos so you can add your profile photo, shop logo and dish photos.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>When you confirm a delivery, Phloem records where your phone is, for Phloem staff only in case of a problem.</string>
	<key>NSCameraUsageDescription</key>
	<string>Phloem uses the camera so you can take your profile photo, shop logo and dish photos, and a photo when you deliver an order.</string>
	<!-- Voice search (Services/Voice) and staff recording dish-name pronunciations: shown by iOS the first time -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Phloem uses the microphone when you search by voice, and when staff record how a dish name is said.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Phloem turns what you say into search words. Apple may process the audio; Phloem only receives the text.</string>
	<!-- Sign in with Face ID (Services/Biometrics): shown by iOS the first time -->
	<key>NSFaceIDUsageDescription</key>
	<string>Phloem uses Face ID so you can sign in without typing your password. Your face data stays on your iPhone.</string>
	<!-- "Continue with Google": the API sends the browser back to phloem://auth (see Services/ExternalSignIn.cs) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.zayun.phloem</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>phloem</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
		</dict>
	</array>
</dict>
</plist>
