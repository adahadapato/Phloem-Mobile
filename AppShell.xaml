<?xml version="1.0" encoding="UTF-8" ?>
<!--
    AppShell: the container every page loads inside.

    Bottom bar (always visible): Home · Explore · Orders (basket + recent orders) · Account
    Every other page opens ON TOP of a tab, so the bottom bar stays on screen:
        About, Help, Contact us, Log In, Sign Up, Admin → open under the Account tab (Account stays highlighted)
        Vendors, Become a Seller,
        Seller Dashboard           → open under the Home tab
    Those page routes are registered in AppShell.xaml.cs.
-->
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Phloem.Views"
       x:Class="Phloem.AppShell"
       Title="Phloem"
       FlyoutBehavior="Flyout"
       FlyoutBackgroundColor="{StaticResource BrandCream}"
       BackgroundColor="{StaticResource BrandDark}"
       Shell.TabBarBackgroundColor="{StaticResource BrandNavGreen}"
       Shell.TabBarForegroundColor="{StaticResource BrandOrangeLight}"
       Shell.TabBarTitleColor="{StaticResource BrandOrangeLight}"
       Shell.TabBarUnselectedColor="{StaticResource BrandMint}">

    <!-- ============ Side menu header ============ -->
    <Shell.FlyoutHeader>
        <Grid HeightRequest="150" BackgroundColor="{StaticResource BrandDark}" Padding="20,0">
            <Ellipse Stroke="#1AFFFFFF" StrokeThickness="10" WidthRequest="300" HeightRequest="300"
                     HorizontalOptions="Start" VerticalOptions="Start" Margin="-90,-40,0,0" />
            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <Image Source="header_logo.png" WidthRequest="48" HeightRequest="48" VerticalOptions="Center" />
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="Phloem" FontSize="24" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Connecting Africa to its diaspora" FontSize="12"
                           TextColor="{StaticResource BrandGoldLight}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <!-- Close button (top right): closes the menu, same as tapping outside it -->
            <Border HorizontalOptions="End" VerticalOptions="Start" Margin="0,14,-6,0"
                    WidthRequest="40" HeightRequest="40" StrokeThickness="0"
                    StrokeShape="RoundRectangle 20" BackgroundColor="#26FFFFFF"
                    SemanticProperties.Description="Close menu">
                <Label Text="✕" FontSize="18" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseMenuTapped" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- ============ Side menu: style for the tab entries ============ -->
    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid Padding="12,3">
                <Border x:Name="ItemBorder" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                        Padding="14,12" BackgroundColor="Transparent">
                    <Label x:Name="ItemLabel" Text="{Binding Title}" FontSize="15"
                           TextColor="{StaticResource BrandTextDark}" />
                </Border>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter TargetName="ItemBorder" Property="Border.BackgroundColor"
                                            Value="{StaticResource BrandMint}" />
                                    <Setter TargetName="ItemLabel" Property="Label.TextColor"
                                            Value="{StaticResource BrandDark}" />
                                    <Setter TargetName="ItemLabel" Property="Label.FontAttributes" Value="Bold" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <!-- ============ Side menu: style for the other pages (same look) ============ -->
    <!--<Shell.MenuItemTemplate>
        <DataTemplate>
            <Grid Padding="12,3">
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 12"
                        Padding="14,12" BackgroundColor="Transparent">
                    <Label Text="{Binding Text}" FontSize="15"
                           TextColor="{StaticResource BrandTextDark}" />
                </Border>
            </Grid>
        </DataTemplate>
    </Shell.MenuItemTemplate>-->

    <!-- ============ Side menu: style for the other pages (same look) ============ -->
    <Shell.MenuItemTemplate>
        <DataTemplate>
            <VerticalStackLayout Spacing="0">
                <Grid Padding="12,3">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 12"
                        Padding="14,12" BackgroundColor="Transparent">
                        <Label Text="{Binding Text}" FontSize="15"
                           TextColor="{StaticResource BrandTextDark}" />
                    </Border>
                </Grid>

                <!-- Divider line: only shown under "Contact us" (About, Help and Contact sit together at the top) -->
                <BoxView HeightRequest="1" Color="{StaticResource BrandBorder}"
                     Margin="26,6,26,6" IsVisible="False">
                    <BoxView.Triggers>
                        <DataTrigger TargetType="BoxView" Binding="{Binding Text}" Value="Contact us">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </BoxView.Triggers>
                </BoxView>
            </VerticalStackLayout>
        </DataTemplate>
    </Shell.MenuItemTemplate>

    <!-- ============ Bottom bar: 4 tabs ============ -->
    <!--<FlyoutItem Title="Phloem" Route="main" FlyoutDisplayOptions="AsMultipleItems">-->
    <!-- Hidden from the ☰ side menu: Home, Explore, Orders and Account are already on the bottom bar. -->
    <FlyoutItem Title="Phloem" Route="main" FlyoutDisplayOptions="AsSingleItem"
            Shell.FlyoutItemIsVisible="False">
        <Tab Title="Home" Icon="tab_home.png">
            <ShellContent Title="Home" ContentTemplate="{DataTemplate views:HomePage}" Route="home" />
        </Tab>
        <Tab Title="Explore" Icon="tab_explore.png">
            <ShellContent Title="Browse &amp; Order" ContentTemplate="{DataTemplate views:FoodListingPage}" Route="listing" />
        </Tab>
        <Tab Title="Orders" Icon="tab_orders.png">
            <ShellContent Title="My Orders" ContentTemplate="{DataTemplate views:OrdersPage}" Route="orders" />
        </Tab>
        <Tab Title="Account" Icon="tab_account.png">
            <ShellContent Title="My Account" ContentTemplate="{DataTemplate views:AccountPage}" Route="account" />
        </Tab>
    </FlyoutItem>

    <!-- ============ Side menu: other pages (open on top of a tab, bottom bar stays) ============ -->
    <!-- Items with x:Name are shown or hidden by who is signed in (see AppShell.xaml.cs, UpdateMenu) -->
    <MenuItem Text="About"            CommandParameter="//account/about"      Clicked="OnMenuItemClicked" />
    <MenuItem Text="Help &amp; support" CommandParameter="//account/legal?type=Help" Clicked="OnMenuItemClicked" />
    <MenuItem Text="Contact us"       CommandParameter="//account/contact"    Clicked="OnMenuItemClicked" />
    <MenuItem x:Name="AdminMenuItem"         Text="Admin Dashboard"  CommandParameter="//account/admin"      Clicked="OnMenuItemClicked" />
    <MenuItem Text="Send Food to UK"  CommandParameter="//home/international" Clicked="OnMenuItemClicked" />
    <MenuItem Text="Sellers &amp; Vendors" CommandParameter="//home/vendors" Clicked="OnMenuItemClicked" />
    <MenuItem x:Name="BecomeSellerMenuItem"  Text="Become a Seller"  CommandParameter="//home/sellersetup" Clicked="OnMenuItemClicked" />
    <MenuItem x:Name="SellerDashMenuItem"    Text="Seller Dashboard" CommandParameter="//home/dashboard"   Clicked="OnMenuItemClicked" />
    <MenuItem x:Name="MyShipmentsMenuItem"   Text="My Shipments"     CommandParameter="//account/myshipments" Clicked="OnMenuItemClicked" />
    <MenuItem x:Name="MyDeliveriesMenuItem"  Text="My Deliveries"    CommandParameter="//account/deliveries"  Clicked="OnMenuItemClicked" />
    <MenuItem x:Name="SignUpMenuItem"        Text="Sign Up"          CommandParameter="//account/register"   Clicked="OnMenuItemClicked" />

</Shell>
