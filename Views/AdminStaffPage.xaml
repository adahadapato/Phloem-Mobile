<?xml version="1.0" encoding="UTF-8" ?>
<!--
    AdminStaffPage (route "adminstaff"): Admin → Staff, read-only.
    The owners and everyone with a job role: their roles, the countries they cover, whether two-step sign-in is on
    (required for all staff) and their last sign-in. Changing roles, countries and what a role may do is on the website.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:phloem="clr-namespace:Phloem"
             xmlns:vm="clr-namespace:Phloem.ViewModels"
             xmlns:controls="clr-namespace:Phloem.Views.Controls"
             x:DataType="vm:AdminStaffViewModel"
             x:Class="Phloem.Views.AdminStaffPage"
             Shell.NavBarIsVisible="False"
             Title="Staff">

    <ContentPage.Resources>
        <Style x:Key="WhiteCard" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="Black" Opacity="0.06" Radius="10" Offset="0,3" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallMuted" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextMuted}" />
        </Style>
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ============ GREEN HEADER (back arrow) ============ -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource BrandDark}" HeightRequest="72">
            <Ellipse Stroke="#1AFFFFFF" StrokeThickness="10" WidthRequest="320" HeightRequest="320"
                     HorizontalOptions="Start" VerticalOptions="Start" Margin="-60,-30,0,0" InputTransparent="True" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="14,0,16,0">
                <Grid WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                    <Path Data="M15,5 L8,12 L15,19" Stroke="White" StrokeThickness="2.6"
                          StrokeLineCap="Round" StrokeLineJoin="Round" WidthRequest="24" HeightRequest="24"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Grid.GestureRecognizers>
                </Grid>
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{x:Static phloem:AppNav.GoHomeCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Image Source="header_logo.png" WidthRequest="34" HeightRequest="34" />
                    <Label Text="Phloem" TextColor="White" FontSize="22" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
        </Grid>

        <RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsLoading}">
            <ScrollView>
                <VerticalStackLayout Padding="16,18,16,28" Spacing="14" MaximumWidthRequest="560" HorizontalOptions="Fill">

                    <VerticalStackLayout Spacing="2" Margin="2,0,0,0">
                        <Label Text="Staff" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource BrandTextDark}" />
                        <Label Text="The owners and everyone with a job role. To change roles or countries, use the Phloem website (Staff area → Staff)."
                               Style="{StaticResource SubtleLabel}" FontSize="13" LineBreakMode="WordWrap" />
                        <Label Text="{Binding CountText}" Style="{StaticResource SmallMuted}" Margin="0,6,0,0" />
                    </VerticalStackLayout>

                    <controls:StatusBanner Message="{Binding Message}" IsError="{Binding IsError}" />

                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding People}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:StaffCard">
                                <Border Style="{StaticResource WhiteCard}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <!-- Initial -->
                                        <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="Ellipse"
                                                BackgroundColor="{StaticResource BrandMintPale}" VerticalOptions="Start">
                                            <Label Text="{Binding Initial}" FontSize="18" FontAttributes="Bold"
                                                   TextColor="{StaticResource BrandDark}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Label Text="{Binding FullName}" FontSize="16" FontAttributes="Bold"
                                                       TextColor="{StaticResource BrandTextDark}" LineBreakMode="TailTruncation" />
                                                <!-- 2-step: green when on, orange when off (required for staff) -->
                                                <Border Grid.Column="1" Style="{StaticResource Pill}"
                                                        BackgroundColor="{StaticResource BrandMintPale}">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding TwoFactorOff}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource BrandPeach}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Label Text="{Binding TwoFactorText}" FontSize="11" FontAttributes="Bold"
                                                           TextColor="{StaticResource BrandDark}" />
                                                </Border>
                                            </Grid>
                                            <Label Text="{Binding Email}" Style="{StaticResource SmallMuted}" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding RolesText}" FontSize="13" FontAttributes="Bold"
                                                   TextColor="{StaticResource BrandGreen}" LineBreakMode="WordWrap" />
                                            <Label Text="{Binding CountriesText}" FontSize="13"
                                                   TextColor="{StaticResource BrandTextDark}" LineBreakMode="WordWrap" />
                                            <Label Text="{Binding LastSignInText}" Style="{StaticResource SmallMuted}" />
                                            <Label Text="Suspended" FontSize="12" FontAttributes="Bold"
                                                   TextColor="{StaticResource BrandDanger}" IsVisible="{Binding IsSuspended}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
