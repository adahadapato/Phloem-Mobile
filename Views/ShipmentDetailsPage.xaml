<?xml version="1.0" encoding="UTF-8" ?>
<!--
    ShipmentDetailsPage (route "shipmentdetails?tracking=…[&staff=true]"): one parcel from the API.
    Status, where to drop it off (until it's dropped off), timeline, recipient, items, weight and price.
    Sender: Pay (test payment, once weighed) and Cancel.  Staff: Received at hub (weight) and the next step.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:Phloem.Helpers"
             xmlns:controls="clr-namespace:Phloem.Views.Controls"
             xmlns:phloem="clr-namespace:Phloem"
             xmlns:vm="clr-namespace:Phloem.ViewModels"
             xmlns:models="clr-namespace:Phloem.Models"
             x:DataType="vm:ShipmentDetailsViewModel"
             x:Class="Phloem.Views.ShipmentDetailsPage"
             Shell.NavBarIsVisible="False"
             Title="Shipment details">

    <!-- Keeps the screen on while this page is open (My account → Keep screen on) -->
    <ContentPage.Behaviors>
        <helpers:KeepScreenAwakeBehavior />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <Style x:Key="WhiteCard" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="Black" Opacity="0.06" Radius="10" Offset="0,3" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallMuted" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextMuted}" />
        </Style>
        <Style x:Key="CardTitle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextMuted}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ============ GREEN HEADER (back arrow) ============ -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource BrandDark}" HeightRequest="72">
            <Ellipse Stroke="#1AFFFFFF" StrokeThickness="10" WidthRequest="320" HeightRequest="320"
                     HorizontalOptions="Start" VerticalOptions="Start" Margin="-60,-30,0,0" InputTransparent="True" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="14,0,16,0">
                <Grid WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                    <Path Data="M15,5 L8,12 L15,19" Stroke="White" StrokeThickness="2.6"
                          StrokeLineCap="Round" StrokeLineJoin="Round" WidthRequest="24" HeightRequest="24"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Grid.GestureRecognizers>
                </Grid>
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{x:Static phloem:AppNav.GoHomeCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Image Source="header_logo.png" WidthRequest="34" HeightRequest="34" />
                    <Label Text="Phloem" TextColor="White" FontSize="22" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,18,16,28" Spacing="12" MaximumWidthRequest="560" HorizontalOptions="Fill">

                <!-- ============ TITLE + STATUS ============ -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="2,0,0,4">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Shipment details" FontSize="26" FontAttributes="Bold"
                               TextColor="{StaticResource BrandTextDark}" />
                        <Label Text="{Binding TrackingNumber}" FontSize="13" FontAttributes="Bold"
                               TextColor="{StaticResource BrandDark}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" BackgroundColor="{StaticResource BrandMintPale}" StrokeThickness="0"
                            StrokeShape="RoundRectangle 10" Padding="10,4" VerticalOptions="Center"
                            IsVisible="{Binding HasShipment}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsCancelled}" Value="True">
                                <Setter Property="BackgroundColor" Value="#FDECEA" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding StatusText}" FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource BrandDark}" />
                    </Border>
                </Grid>

                <Label Text="{Binding Message}" Style="{StaticResource SubtleLabel}" FontSize="14"
                       HorizontalTextAlignment="Center"
                       IsVisible="{Binding Message, Converter={StaticResource StringNotEmptyConverter}}" />

                <VerticalStackLayout Spacing="12" IsVisible="{Binding HasShipment}">

                    <!-- Refund note -->
                    <Border BackgroundColor="#FDECEA" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14,10"
                            IsVisible="{Binding NeedsRefund}">
                        <Label Text="{Binding RefundText}" FontSize="13" TextColor="{StaticResource BrandDanger}" />
                    </Border>

                    <!-- Drop it off (only while Booked) -->
                    <Border BackgroundColor="#FFF1E0" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="14"
                            IsVisible="{Binding ShowDropOff}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Drop your parcel at" FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource BrandTextDark}" />
                            <Label Text="{Binding DropOffText}" FontSize="14" TextColor="{StaticResource BrandTextDark}"
                                   LineBreakMode="WordWrap" />
                            <Label Text="Write the tracking number on it. We'll weigh it, then you can pay here."
                                   Style="{StaticResource SmallMuted}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- ============ ACTIONS ============ -->
                    <Button Text="{Binding PriceText, StringFormat='Pay {0} (test payment)'}" Command="{Binding PayCommand}"
                            Style="{StaticResource CtaButton}" IsVisible="{Binding CanPay}" />
                    <Button Text="Received at hub · enter weight" Command="{Binding ReceiveCommand}"
                            Style="{StaticResource CtaButton}" IsVisible="{Binding CanReceive}" />
                    <Button Text="{Binding NextStepText}" Command="{Binding MoveOnCommand}"
                            Style="{StaticResource CtaButton}" IsVisible="{Binding CanMoveOn}" />
                    <Label Text="{Binding CourierText}" FontSize="14" FontAttributes="Bold"
                           TextColor="{StaticResource BrandDark}" Margin="2,0,0,0" IsVisible="{Binding HasCourier}" />
                    <Button Text="Change courier" Command="{Binding ChangeCourierCommand}"
                            Style="{StaticResource OutlineButton}" IsVisible="{Binding CanChangeCourier}" />

                    <!-- Delivered: the courier's photo -->
                    <controls:DeliveryProofCard Proof="{Binding Proof}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource BrandDark}" HeightRequest="28" />

                    <!-- ============ PARCEL ============ -->
                    <Border Style="{StaticResource WhiteCard}">
                        <VerticalStackLayout Spacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Route" Style="{StaticResource CardTitle}" />
                                <Label Text="{Binding RouteText}" FontSize="14" TextColor="{StaticResource BrandTextDark}"
                                   LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Speed" Style="{StaticResource CardTitle}" />
                                <Label Text="{Binding SpeedText}" FontSize="14" TextColor="{StaticResource BrandTextDark}"
                                   LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Arrival" Style="{StaticResource CardTitle}" />
                                <Label Text="{Binding ArrivalText}" FontSize="14" TextColor="{StaticResource BrandTextDark}"
                                   LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Weight" Style="{StaticResource CardTitle}" />
                                <Label Text="{Binding WeightText}" FontSize="14" TextColor="{StaticResource BrandTextDark}"
                                   LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding PriceCaption}" Style="{StaticResource CardTitle}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding PriceText}" FontSize="18" FontAttributes="Bold"
                                       TextColor="{StaticResource BrandDark}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ============ PEOPLE ============ -->
                    <Border Style="{StaticResource WhiteCard}">
                        <VerticalStackLayout Spacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Recipient" Style="{StaticResource CardTitle}" />
                                <Label Text="{Binding RecipientText}" FontSize="14" TextColor="{StaticResource BrandTextDark}"
                                   LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Sender" Style="{StaticResource CardTitle}" />
                                <Label Text="{Binding SenderText}" FontSize="14" TextColor="{StaticResource BrandTextDark}"
                                   LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ============ ITEMS ============ -->
                    <Label Text="What's inside" Style="{StaticResource SectionTitle}" FontSize="17" Margin="2,6,0,0" />
                    <Border Style="{StaticResource WhiteCard}">
                        <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Items}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ShipmentItemLine">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Spacing="1">
                                            <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold"
                                                   TextColor="{StaticResource BrandTextDark}" />
                                            <Label Text="{Binding Subtitle}" Style="{StaticResource SmallMuted}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding ValueText}" FontSize="13"
                                               TextColor="{StaticResource BrandTextMuted}" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ============ TIMELINE (newest first) ============ -->
                    <Label Text="Timeline" Style="{StaticResource SectionTitle}" FontSize="17" Margin="2,6,0,0" />
                    <Border Style="{StaticResource WhiteCard}">
                        <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding Timeline}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ShipmentStep">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Ellipse WidthRequest="12" HeightRequest="12" Fill="{StaticResource BrandGreen}"
                                                 VerticalOptions="Start" Margin="0,4,0,0">
                                            <Ellipse.Triggers>
                                                <DataTrigger TargetType="Ellipse" Binding="{Binding IsCancelled}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource BrandDanger}" />
                                                </DataTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                                            <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold"
                                                   TextColor="{StaticResource BrandTextDark}" />
                                            <Label Text="{Binding WhenText}" Style="{StaticResource SmallMuted}" />
                                            <Label Text="{Binding Note}" FontSize="12" TextColor="{StaticResource BrandTextDark}"
                                                   IsVisible="{Binding HasNote}" LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Cancel (sender, before it leaves) -->
                    <Button Text="Cancel this parcel" Command="{Binding CancelCommand}"
                            Style="{StaticResource OutlineButton}" TextColor="{StaticResource BrandDanger}"
                            IsVisible="{Binding CanCancel}" Margin="0,8,0,0" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
