<?xml version="1.0" encoding="UTF-8" ?>
<!--
    InternationalDeliveryPage (route "international"): Send a parcel, booked on the API.
    Its own booking (not part of the basket):
      1. route (only routes an admin switched on) and speed
      2. boxes (weight, outside size explained with a drawing, how many; "counts as" at once) and Fragile
      3. items for customs
      4. getting it to us (drop off / home pickup) - options a route doesn't offer are greyed out
      5. recipient: town with suggestions → State + LGA (full-screen lists; AI suggests the LGA of a town we don't
         know), and how it reaches them (to the door / collect from our hub)
      6. your phone; live price part by part; Book → tracking number and what happens next
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:phloem="clr-namespace:Phloem"
             xmlns:vm="clr-namespace:Phloem.ViewModels"
             xmlns:controls="clr-namespace:Phloem.Views.Controls"
             xmlns:models="clr-namespace:Phloem.Models"
             xmlns:dtos="clr-namespace:Phloem.Services.Api.Contracts.Dtos"
             x:DataType="vm:InternationalDeliveryViewModel"
             x:Class="Phloem.Views.InternationalDeliveryPage"
             Shell.NavBarIsVisible="False"
             Title="Send Food to UK">

    <ContentPage.Resources>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>
        <Style x:Key="FieldBox" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="{StaticResource BrandBorder}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HeightRequest" Value="48" />
        </Style>
        <Style x:Key="FieldEntry" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
            <Setter Property="PlaceholderColor" Value="{StaticResource BrandTextMuted}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="FormCard" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 18" />
            <Setter Property="Padding" Value="16,18" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="Black" Opacity="0.06" Radius="12" Offset="0,3" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChoiceCard" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="{StaticResource BrandBorder}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ============ GREEN HEADER ============ -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource BrandDark}" HeightRequest="72">
            <Ellipse Stroke="#1AFFFFFF" StrokeThickness="10"
                     WidthRequest="320" HeightRequest="320"
                     HorizontalOptions="Start" VerticalOptions="Start"
                     Margin="-60,-30,0,0" InputTransparent="True" />

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="18,0,16,0">
                <Grid WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                    <Path Data="M2,5 L22,5 M2,12 L22,12 M2,19 L22,19"
                          Stroke="White" StrokeThickness="2.4" StrokeLineCap="Round"
                          WidthRequest="24" HeightRequest="24"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMenuTapped" />
                    </Grid.GestureRecognizers>
                </Grid>

                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{x:Static phloem:AppNav.GoHomeCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Image Source="header_logo.png" WidthRequest="34" HeightRequest="34" />
                    <Label Text="Phloem" TextColor="White" FontSize="22" FontAttributes="Bold"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- My shipments -->
                <Border Grid.Column="2" BackgroundColor="White" StrokeThickness="0"
                        StrokeShape="RoundRectangle 16" Padding="12,4" HeightRequest="32"
                        VerticalOptions="Center" IsVisible="{Binding IsLoggedIn}">
                    <Label Text="📦 My shipments" FontSize="12" FontAttributes="Bold"
                           TextColor="{StaticResource BrandDark}" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToMyShipmentsCommand}" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,18,16,28" Spacing="14"
                                 MaximumWidthRequest="560" HorizontalOptions="Fill">

                <!-- ============ TITLE ============ -->
                <VerticalStackLayout Spacing="2" Margin="2,0,0,0">
                    <Label Text="Send food to the UK" FontSize="26" FontAttributes="Bold"
                           TextColor="{StaticResource BrandTextDark}" />
                    <Label Text="Book a parcel, drop it at our hub or we collect it, we deliver it"
                           Style="{StaticResource SubtleLabel}" FontSize="13" />
                </VerticalStackLayout>

                <!-- ============ ORANGE BANNER: how it works ============ -->
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="16,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{StaticResource BrandOrange}" Offset="0.0" />
                            <GradientStop Color="{StaticResource BrandOrangeDark}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <VerticalStackLayout Spacing="4">
                        <HorizontalStackLayout Spacing="10">
                            <Path Data="M21,16 L21,14 L13,9 L13,3.5 A1.5,1.5 0 0 0 10,3.5 L10,9 L2,14 L2,16 L10,13.5 L10,19 L8,20.5 L8,22 L11.5,21 L15,22 L15,20.5 L13,19 L13,13.5 Z"
                                  Fill="White" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"
                                  Rotation="90" />
                            <Label Text="How it works" FontSize="17" FontAttributes="Bold"
                                   TextColor="White" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Text="1. Book here  ·  2. Drop it at the hub, or we collect it  ·  3. We weigh and measure it, you pay the final price  ·  4. We deliver it, or they collect it"
                               FontSize="12" TextColor="White" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============ NOT SIGNED IN ============ -->
                <Border Style="{StaticResource FormCard}" IsVisible="{Binding IsGuest}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Log in to book a parcel" FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource BrandTextDark}" />
                        <Label Text="You can look at routes and prices now; booking needs an account."
                               Style="{StaticResource SubtleLabel}" FontSize="13" />
                        <Button Text="Log in" Command="{Binding GoToLoginCommand}" Style="{StaticResource CtaButton}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============ BOOKED ============ -->
                <Border Style="{StaticResource FormCard}" IsVisible="{Binding IsBooked}"
                        BackgroundColor="{StaticResource BrandMintPale}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="✓ Parcel booked" FontSize="20" FontAttributes="Bold"
                               TextColor="{StaticResource BrandDark}" />
                        <Label FontSize="14" TextColor="{StaticResource BrandTextDark}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Tracking number: " />
                                    <Span Text="{Binding Booked.TrackingNumber}" FontAttributes="Bold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Text="{Binding BookedPriceText}" FontSize="14" TextColor="{StaticResource BrandTextDark}" />
                        <BoxView HeightRequest="1" Color="{StaticResource BrandMint}" />
                        <VerticalStackLayout Spacing="4" IsVisible="{Binding BookedIsDropOff}">
                            <Label Text="Drop it off at" FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource BrandTextDark}" />
                            <Label Text="{Binding Booked.DropOffAddress}" FontSize="14" TextColor="{StaticResource BrandTextDark}"
                                   LineBreakMode="WordWrap" />
                            <Label Text="{Binding Booked.DropOffHours}" FontSize="13" TextColor="{StaticResource BrandTextMuted}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4" IsVisible="{Binding BookedIsPickup}">
                            <Label Text="We'll collect it from you" FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource BrandTextDark}" />
                            <Label Text="Our team will call you to arrange a pickup time. Please have it packed, taped and labelled."
                                   FontSize="13" TextColor="{StaticResource BrandTextDark}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Label Text="Write the tracking number on every box. We'll weigh and measure them at the hub; then pay the final price from My shipments."
                               FontSize="12" TextColor="{StaticResource BrandTextMuted}" LineBreakMode="WordWrap" />
                        <Label Text="{Binding BookedCollectionText}" IsVisible="{Binding BookedHasCollection}"
                               FontSize="12" TextColor="{StaticResource BrandTextDark}" LineBreakMode="WordWrap" />
                        <Button Text="View my shipments" Command="{Binding GoToMyShipmentsCommand}"
                                Style="{StaticResource CtaButton}" />
                        <Button Text="Send another parcel" Command="{Binding SendAnotherCommand}"
                                Style="{StaticResource OutlineButton}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============ THE FORM ============ -->
                <VerticalStackLayout Spacing="14" IsVisible="{Binding IsFormVisible}">

                    <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                       Color="{StaticResource BrandDark}" HeightRequest="28" />

                    <!-- No route switched on yet -->
                    <Border Style="{StaticResource FormCard}" IsVisible="{Binding HasNoRoutes}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Parcels aren't available yet" FontSize="16" FontAttributes="Bold"
                                   TextColor="{StaticResource BrandTextDark}" />
                            <Label Text="No shipping route is switched on at the moment. Please check again soon."
                                   Style="{StaticResource SubtleLabel}" FontSize="13" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="14" IsVisible="{Binding HasRoutes}">

                        <!-- ===== 1. Route and speed ===== -->
                        <Border Style="{StaticResource FormCard}">
                            <VerticalStackLayout Spacing="14">
                                <VerticalStackLayout>
                                    <Label Text="From → To" Style="{StaticResource FieldLabel}" />
                                    <Border Style="{StaticResource FieldBox}">
                                        <Picker ItemsSource="{Binding Routes}" SelectedItem="{Binding SelectedRoute}"
                                                ItemDisplayBinding="{Binding Display}" Title="Choose the route"
                                                TextColor="{StaticResource BrandTextDark}" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="{Binding DropOffText, StringFormat='Drop-off: {0}'}" FontSize="12"
                                           TextColor="{StaticResource BrandTextMuted}" Margin="2,6,0,0"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>

                                <Label Text="Delivery speed" Style="{StaticResource FieldLabel}" Margin="2,4,0,0" />
                                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Speeds}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SpeedChoice">
                                            <Border StrokeThickness="1" Stroke="{StaticResource BrandBorder}"
                                                    StrokeShape="RoundRectangle 12" Padding="14,10" BackgroundColor="White">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Stroke" Value="{StaticResource BrandDark}" />
                                                        <Setter Property="BackgroundColor" Value="{StaticResource BrandMintPale}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding SelectSpeedCommand, Source={RelativeSource AncestorType={x:Type vm:InternationalDeliveryViewModel}}}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <VerticalStackLayout Spacing="2">
                                                        <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold"
                                                               TextColor="{StaticResource BrandTextDark}" />
                                                        <Label Text="{Binding PriceText}" FontSize="12"
                                                               TextColor="{StaticResource BrandTextMuted}" />
                                                    </VerticalStackLayout>
                                                    <Label Grid.Column="1" Text="{Binding DaysText}" FontSize="13"
                                                           FontAttributes="Bold" TextColor="{StaticResource BrandDark}"
                                                           VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- ===== 2. Your boxes ===== -->
                        <Border Style="{StaticResource FormCard}">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Your boxes" FontSize="16" FontAttributes="Bold"
                                       TextColor="{StaticResource BrandTextDark}" />

                                <!-- Why we ask for the size (tap to open) -->
                                <Border BackgroundColor="{StaticResource BrandMintPale}" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12" Padding="14,12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleExplainerCommand}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="📦 Why we ask for the size" FontSize="14" FontAttributes="Bold"
                                                   TextColor="{StaticResource BrandDark}" />
                                            <Label Grid.Column="1" Text="Show" FontSize="13" FontAttributes="Bold"
                                                   TextColor="{StaticResource BrandGreen}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsExplainerOpen}" Value="True">
                                                        <Setter Property="Text" Value="Hide" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Grid>
                                        <VerticalStackLayout Spacing="8" IsVisible="{Binding IsExplainerOpen}">
                                            <controls:BoxDiagram />
                                            <Label Text="{Binding SizeExplainer}" FontSize="13" LineBreakMode="WordWrap"
                                                   TextColor="{StaticResource BrandTextDark}" />
                                            <Label FontSize="13" LineBreakMode="WordWrap" TextColor="{StaticResource BrandTextMuted}"
                                                   Text="• Measure the OUTSIDE of the box with a tape measure, after packing and taping it.&#10;• Length is the longest side, width the side next to it, height from the bottom to the top.&#10;• Round up to the next whole cm.&#10;• Not sure yet? Leave the size empty: we measure every box at the hub and the final price uses our measurements." />
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>

                                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Boxes}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:ParcelBoxDraft">
                                            <Border StrokeThickness="1" Stroke="{StaticResource BrandBorder}"
                                                    StrokeShape="RoundRectangle 12" Padding="12">
                                                <VerticalStackLayout Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold"
                                                               TextColor="{StaticResource BrandTextDark}" VerticalOptions="Center" />
                                                        <Label Grid.Column="1" Text="Remove" Style="{StaticResource LinkLabel}"
                                                               TextColor="{StaticResource BrandDanger}" IsVisible="{Binding CanRemove}">
                                                            <Label.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding RemoveBoxCommand, Source={RelativeSource AncestorType={x:Type vm:InternationalDeliveryViewModel}}}"
                                                                    CommandParameter="{Binding .}" />
                                                            </Label.GestureRecognizers>
                                                        </Label>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                        <VerticalStackLayout>
                                                            <Label Text="Weight of one box (kg)" Style="{StaticResource FieldLabel}" />
                                                            <Border Style="{StaticResource FieldBox}">
                                                                <Entry Placeholder="e.g. 8.5" Text="{Binding Weight}" Keyboard="Numeric"
                                                                       Style="{StaticResource FieldEntry}" />
                                                            </Border>
                                                        </VerticalStackLayout>
                                                        <VerticalStackLayout Grid.Column="1">
                                                            <Label Text="How many" Style="{StaticResource FieldLabel}" />
                                                            <Border Style="{StaticResource FieldBox}">
                                                                <Entry Placeholder="1" Text="{Binding Quantity}" Keyboard="Numeric"
                                                                       Style="{StaticResource FieldEntry}" />
                                                            </Border>
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                    <Label Text="Outside size in cm (optional)" Style="{StaticResource FieldLabel}" Margin="2,2,0,0" />
                                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                                        <Border Style="{StaticResource FieldBox}">
                                                            <Entry Placeholder="Length" Text="{Binding Length}" Keyboard="Numeric"
                                                                   Style="{StaticResource FieldEntry}" />
                                                        </Border>
                                                        <Border Grid.Column="1" Style="{StaticResource FieldBox}">
                                                            <Entry Placeholder="Width" Text="{Binding Width}" Keyboard="Numeric"
                                                                   Style="{StaticResource FieldEntry}" />
                                                        </Border>
                                                        <Border Grid.Column="2" Style="{StaticResource FieldBox}">
                                                            <Entry Placeholder="Height" Text="{Binding Height}" Keyboard="Numeric"
                                                                   Style="{StaticResource FieldEntry}" />
                                                        </Border>
                                                    </Grid>
                                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,8"
                                                            BackgroundColor="{StaticResource BrandCream}">
                                                        <Border.Triggers>
                                                            <DataTrigger TargetType="Border" Binding="{Binding ChargedBySize}" Value="True">
                                                                <Setter Property="BackgroundColor" Value="{StaticResource BrandPeach}" />
                                                            </DataTrigger>
                                                        </Border.Triggers>
                                                        <Label Text="{Binding CountsText}" FontSize="13" LineBreakMode="WordWrap"
                                                               TextColor="{StaticResource BrandTextDark}" />
                                                    </Border>
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Label Text="+ Add a different box" Style="{StaticResource LinkLabel}"
                                       TextColor="{StaticResource BrandDark}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding AddBoxCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>

                                <!-- Fragile -->
                                <Border StrokeThickness="1" Stroke="{StaticResource BrandBorder}" StrokeDashArray="4,3"
                                        StrokeShape="RoundRectangle 12" Padding="8,6">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                        <CheckBox IsChecked="{Binding IsFragile}" Color="{StaticResource BrandDark}" />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label FontSize="14" TextColor="{StaticResource BrandTextDark}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Fragile: handle with care  " FontAttributes="Bold" />
                                                        <Span Text="{Binding FragileText}" TextColor="{StaticResource BrandTextMuted}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label Text="Glass jars, bottles or electronics. We label the boxes and keep them on top."
                                                   FontSize="12" TextColor="{StaticResource BrandTextMuted}" LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <!-- ===== 3. What's in the parcel ===== -->
                        <Border Style="{StaticResource FormCard}">
                            <VerticalStackLayout Spacing="14">
                                <Label Text="What's in the parcel" FontSize="16" FontAttributes="Bold"
                                       TextColor="{StaticResource BrandTextDark}" />
                                <Label Text="For customs. Values are for ONE item." FontSize="12"
                                       TextColor="{StaticResource BrandTextMuted}" Margin="0,-8,0,0" />

                                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Items}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ParcelItem">
                                            <Border StrokeThickness="1" Stroke="{StaticResource BrandBorder}"
                                                    StrokeShape="RoundRectangle 12" Padding="12">
                                                <VerticalStackLayout Spacing="8">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <Border Style="{StaticResource FieldBox}">
                                                            <Picker ItemsSource="{Binding Categories, Source={RelativeSource AncestorType={x:Type vm:InternationalDeliveryViewModel}}}"
                                                                    SelectedItem="{Binding Category}"
                                                                    ItemDisplayBinding="{Binding Name}" Title="Type"
                                                                    TextColor="{StaticResource BrandTextDark}"
                                                                    VerticalOptions="Center" />
                                                        </Border>
                                                        <Label Grid.Column="1" Text="Remove" Style="{StaticResource LinkLabel}"
                                                               TextColor="{StaticResource BrandDanger}" VerticalOptions="Center">
                                                            <Label.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding RemoveItemCommand, Source={RelativeSource AncestorType={x:Type vm:InternationalDeliveryViewModel}}}"
                                                                    CommandParameter="{Binding .}" />
                                                            </Label.GestureRecognizers>
                                                        </Label>
                                                    </Grid>
                                                    <Border Style="{StaticResource FieldBox}">
                                                        <Entry Placeholder="What is it? e.g. Gari, shito, dried fish"
                                                               Text="{Binding Description}" Style="{StaticResource FieldEntry}" />
                                                    </Border>
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                        <Border Style="{StaticResource FieldBox}">
                                                            <Entry Placeholder="How many" Text="{Binding Quantity}" Keyboard="Numeric"
                                                                   Style="{StaticResource FieldEntry}" />
                                                        </Border>
                                                        <Border Grid.Column="1" Style="{StaticResource FieldBox}">
                                                            <Entry Placeholder="Value of one" Text="{Binding UnitValue}"
                                                                   Keyboard="Numeric" Style="{StaticResource FieldEntry}" />
                                                        </Border>
                                                    </Grid>
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Label Text="+ Add another item" Style="{StaticResource LinkLabel}"
                                       TextColor="{StaticResource BrandDark}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding AddItemCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </VerticalStackLayout>
                        </Border>

                        <!-- ===== 4. Getting it to us ===== -->
                        <Border Style="{StaticResource FormCard}">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Getting it to us" FontSize="16" FontAttributes="Bold"
                                       TextColor="{StaticResource BrandTextDark}" />
                                <Border Style="{StaticResource ChoiceCard}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsDropOff}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource BrandDark}" />
                                            <Setter Property="BackgroundColor" Value="{StaticResource BrandMintPale}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ChooseHandOverCommand}" CommandParameter="HubDropOff" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="I'll drop it off" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource BrandTextDark}" />
                                        <Label Text="No extra charge" FontSize="12" TextColor="{StaticResource BrandTextMuted}" />
                                        <Label Text="{Binding DropOffText}" FontSize="12" TextColor="{StaticResource BrandTextMuted}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Style="{StaticResource ChoiceCard}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsPickup}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource BrandDark}" />
                                            <Setter Property="BackgroundColor" Value="{StaticResource BrandMintPale}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding PickupOffered}" Value="False">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ChooseHandOverCommand}" CommandParameter="HomePickup" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Collect it from me" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource BrandTextDark}" />
                                        <Label Text="{Binding PickupPriceText}" FontSize="12" TextColor="{StaticResource BrandTextMuted}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Border>

                                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsPickup}">
                                    <Border Style="{StaticResource FieldBox}">
                                        <Entry Placeholder="House number and street" Text="{Binding PickupAddressLine}"
                                               Style="{StaticResource FieldEntry}" />
                                    </Border>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <Border Style="{StaticResource FieldBox}">
                                            <Entry Placeholder="City or town" Text="{Binding PickupCity}" Style="{StaticResource FieldEntry}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource FieldBox}">
                                            <Entry Placeholder="{Binding PickupPostcodePlaceholder}" Text="{Binding PickupPostcode}"
                                                   Style="{StaticResource FieldEntry}" />
                                        </Border>
                                    </Grid>
                                    <Border Style="{StaticResource FieldBox}">
                                        <Entry Placeholder="Notes for the driver (optional)" Text="{Binding PickupNotes}"
                                               Style="{StaticResource FieldEntry}" />
                                    </Border>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- ===== 5. Who it's for ===== -->
                        <Border Style="{StaticResource FormCard}">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Who it's for" FontSize="16" FontAttributes="Bold"
                                       TextColor="{StaticResource BrandTextDark}" />
                                <Border Style="{StaticResource FieldBox}">
                                    <Entry Placeholder="Full name" Text="{Binding RecipientName}"
                                           Style="{StaticResource FieldEntry}" />
                                </Border>
                                <Border Style="{StaticResource FieldBox}">
                                    <Entry Placeholder="{Binding RecipientPhonePlaceholder}" Text="{Binding RecipientPhone}"
                                           Keyboard="Telephone" Style="{StaticResource FieldEntry}" />
                                </Border>

                                <!-- Countries with lists (Nigeria): town with suggestions → State + LGA -->
                                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasLocationList}">
                                    <VerticalStackLayout>
                                        <Label Text="Town or area" Style="{StaticResource FieldLabel}" />
                                        <Border Style="{StaticResource FieldBox}">
                                            <Entry Placeholder="e.g. Lekki, Wuse 2, Rumuokoro" Text="{Binding RecipientCity}"
                                                   Style="{StaticResource FieldEntry}" Unfocused="OnTownUnfocused" />
                                        </Border>
                                        <Label Text="Start typing: we fill in the state and LGA." FontSize="11"
                                               TextColor="{StaticResource BrandTextMuted}" Margin="2,4,0,0" />
                                    </VerticalStackLayout>

                                    <!-- Suggestions under the town box -->
                                    <Border IsVisible="{Binding ShowTownSuggestions}" BackgroundColor="White"
                                            Stroke="{StaticResource BrandBorder}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 12" Padding="4">
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding TownSuggestions}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="dtos:TownDto">
                                                    <VerticalStackLayout Padding="10,8" Spacing="1">
                                                        <VerticalStackLayout.GestureRecognizers>
                                                            <TapGestureRecognizer
                                                                Command="{Binding PickTownCommand, Source={RelativeSource AncestorType={x:Type vm:InternationalDeliveryViewModel}}}"
                                                                CommandParameter="{Binding .}" />
                                                        </VerticalStackLayout.GestureRecognizers>
                                                        <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold"
                                                               TextColor="{StaticResource BrandTextDark}" />
                                                        <Label Text="{Binding Where}" FontSize="12" TextColor="{StaticResource BrandTextMuted}" />
                                                    </VerticalStackLayout>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </Border>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <VerticalStackLayout>
                                            <Label Text="{Binding RegionLabel}" Style="{StaticResource FieldLabel}" />
                                            <Border Style="{StaticResource FieldBox}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ChooseRegionCommand}" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Text="{Binding RegionText}" FontSize="14" VerticalOptions="Center"
                                                           TextColor="{StaticResource BrandTextDark}" LineBreakMode="TailTruncation" />
                                                    <Label Grid.Column="1" Text="▾" TextColor="{StaticResource BrandTextMuted}" VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1">
                                            <Label Text="{Binding DistrictLabel}" Style="{StaticResource FieldLabel}" />
                                            <Border Style="{StaticResource FieldBox}">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding CanChooseDistrict}" Value="False">
                                                        <Setter Property="Opacity" Value="0.55" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ChooseDistrictCommand}" />
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Text="{Binding DistrictText}" FontSize="14" VerticalOptions="Center"
                                                           TextColor="{StaticResource BrandTextDark}" LineBreakMode="TailTruncation" />
                                                    <Label Grid.Column="1" Text="▾" TextColor="{StaticResource BrandTextMuted}" VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Border IsVisible="{Binding HasLocationHint}" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                            Padding="10,8" BackgroundColor="{StaticResource BrandMintPale}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding LocationHintIsAi}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource BrandPeach}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                            <Border IsVisible="{Binding LocationHintIsAi}" BackgroundColor="{StaticResource BrandGold}"
                                                    StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="6,1"
                                                    VerticalOptions="Start">
                                                <Label Text="AI" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource BrandTextDark}" />
                                            </Border>
                                            <Label Grid.Column="1" Text="{Binding LocationHint}" FontSize="12" LineBreakMode="WordWrap"
                                                   TextColor="{StaticResource BrandTextDark}" />
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Countries without lists (UK): plain city + postcode -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding HasNoLocationList}">
                                    <Border Style="{StaticResource FieldBox}">
                                        <Entry Placeholder="City or town" Text="{Binding RecipientCity}"
                                               Style="{StaticResource FieldEntry}" />
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource FieldBox}">
                                        <Entry Placeholder="{Binding PostcodePlaceholder}" Text="{Binding RecipientRegionOrPostcode}"
                                               Style="{StaticResource FieldEntry}" />
                                    </Border>
                                </Grid>

                                <!-- How it reaches them -->
                                <Label Text="How it reaches them" Style="{StaticResource FieldLabel}" Margin="2,6,0,0" />
                                <Border Style="{StaticResource ChoiceCard}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsToDoor}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource BrandDark}" />
                                            <Setter Property="BackgroundColor" Value="{StaticResource BrandMintPale}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ChooseDeliveryCommand}" CommandParameter="ToDoor" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Delivered to their door" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource BrandTextDark}" />
                                        <Label Text="{Binding DoorDeliveryText}" FontSize="12" TextColor="{StaticResource BrandTextMuted}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Style="{StaticResource ChoiceCard}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsCollect}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource BrandDark}" />
                                            <Setter Property="BackgroundColor" Value="{StaticResource BrandMintPale}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding CollectionOffered}" Value="False">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ChooseDeliveryCommand}" CommandParameter="CollectFromHub" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="They collect it from our hub" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource BrandTextDark}" />
                                        <Label Text="{Binding CollectionText}" FontSize="12" TextColor="{StaticResource BrandTextMuted}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Style="{StaticResource FieldBox}" IsVisible="{Binding NeedsStreet}">
                                    <Entry Placeholder="House number and street" Text="{Binding RecipientAddressLine}"
                                           Style="{StaticResource FieldEntry}" />
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <!-- ===== 6. Your phone ===== -->
                        <Border Style="{StaticResource FormCard}">
                            <VerticalStackLayout>
                                <Label Text="Your phone number" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource FieldBox}">
                                    <Entry Placeholder="So the hub can reach you about this parcel" Text="{Binding SenderPhone}"
                                           Keyboard="Telephone" Style="{StaticResource FieldEntry}" />
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Estimate, part by part -->
                        <Border BackgroundColor="{StaticResource BrandMintPale}" StrokeThickness="0"
                                StrokeShape="RoundRectangle 12" Padding="14,12">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Text="We get it" FontSize="12" TextColor="{StaticResource BrandTextMuted}" />
                                    <Label Grid.Column="1" Text="{Binding HandOverSummary}" FontSize="12" FontAttributes="Bold"
                                           TextColor="{StaticResource BrandTextDark}" HorizontalTextAlignment="End" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Text="They get it" FontSize="12" TextColor="{StaticResource BrandTextMuted}" />
                                    <Label Grid.Column="1" Text="{Binding DeliverySummary}" FontSize="12" FontAttributes="Bold"
                                           TextColor="{StaticResource BrandTextDark}" HorizontalTextAlignment="End" />
                                </Grid>
                                <Label Text="{Binding WeightSummary}" IsVisible="{Binding HasWeightSummary}" FontSize="12"
                                       TextColor="{StaticResource BrandTextDark}" />
                                <VerticalStackLayout Spacing="4" IsVisible="{Binding HasPriceLines}"
                                                     BindableLayout.ItemsSource="{Binding PriceLines}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PriceLine">
                                            <VerticalStackLayout>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Text="{Binding Label}" FontSize="13" TextColor="{StaticResource BrandTextMuted}" />
                                                    <Label Grid.Column="1" Text="{Binding Amount}" FontSize="13" FontAttributes="Bold"
                                                           TextColor="{StaticResource BrandTextDark}" />
                                                </Grid>
                                                <Label Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="11"
                                                       TextColor="{StaticResource BrandTextMuted}" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <BoxView HeightRequest="1" Color="{StaticResource BrandMint}" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Text="Estimated price" FontSize="13"
                                           TextColor="{StaticResource BrandTextMuted}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding QuoteText}" FontSize="14" FontAttributes="Bold"
                                           TextColor="{StaticResource BrandDark}" HorizontalTextAlignment="End"
                                           VerticalOptions="Center" LineBreakMode="WordWrap" />
                                </Grid>
                                <Label Text="The final price is set when we weigh and measure your boxes at the hub."
                                       FontSize="11" TextColor="{StaticResource BrandTextMuted}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- What we can't carry: from the API (Admin → What can be sent keeps it up to date) -->
                        <Border BackgroundColor="{StaticResource BrandCream}" Stroke="{StaticResource BrandBorder}"
                                StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,12">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="What we can't carry" FontSize="15" FontAttributes="Bold"
                                       TextColor="{StaticResource BrandTextDark}" />
                                <Label Text="{Binding RulesMessage}" IsVisible="{Binding HasRulesMessage}" FontSize="13"
                                       TextColor="{StaticResource BrandTextMuted}" LineBreakMode="WordWrap" />
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding HasNotAllowedRules}">
                                    <Label Text="NOT ALLOWED" FontSize="12" FontAttributes="Bold" CharacterSpacing="1"
                                           TextColor="{StaticResource BrandDanger}" />
                                    <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding NotAllowedRules}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ParcelRuleRow">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                    <Border WidthRequest="18" HeightRequest="18" StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 9" VerticalOptions="Start" Margin="0,1,0,0"
                                                            BackgroundColor="{StaticResource BrandDanger}">
                                                        <Label Text="✕" FontSize="10" FontAttributes="Bold" TextColor="White"
                                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                                    </Border>
                                                    <Label Grid.Column="1" FontSize="13" LineBreakMode="WordWrap"
                                                           TextColor="{StaticResource BrandTextDark}">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{Binding Name}" FontAttributes="Bold" />
                                                                <Span Text="{Binding Detail, StringFormat=' · {0}'}"
                                                                      TextColor="{StaticResource BrandTextMuted}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding HasRestrictedRules}">
                                    <Label Text="ONLY IF" FontSize="12" FontAttributes="Bold" CharacterSpacing="1"
                                           TextColor="{StaticResource BrandOrange}" />
                                    <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding RestrictedRules}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ParcelRuleRow">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                    <Border WidthRequest="18" HeightRequest="18" StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 9" VerticalOptions="Start" Margin="0,1,0,0"
                                                            BackgroundColor="{StaticResource BrandOrange}">
                                                        <Label Text="!" FontSize="10" FontAttributes="Bold" TextColor="White"
                                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                                    </Border>
                                                    <Label Grid.Column="1" FontSize="13" LineBreakMode="WordWrap"
                                                           TextColor="{StaticResource BrandTextDark}">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{Binding Name}" FontAttributes="Bold" />
                                                                <Span Text="{Binding Detail, StringFormat=' · {0}'}"
                                                                      TextColor="{StaticResource BrandTextMuted}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                                <Label Text="This list can change, so please check it each time." FontSize="12"
                                       TextColor="{StaticResource BrandTextMuted}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Confirmations -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <CheckBox IsChecked="{Binding ConfirmedNoProhibitedItems}" Color="{StaticResource BrandDark}" />
                            <Label Grid.Column="1" Text="My parcel contains none of the items we can't carry, and follows the conditions above."
                                   FontSize="13" TextColor="{StaticResource BrandTextDark}" VerticalOptions="Center"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <CheckBox IsChecked="{Binding AcceptedTerms}" Color="{StaticResource BrandDark}" />
                            <Label Grid.Column="1" FontSize="13" TextColor="{StaticResource BrandTextDark}"
                                   VerticalOptions="Center" LineBreakMode="WordWrap">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="I accept the " />
                                        <Span Text="shipping terms" TextColor="{StaticResource BrandGreen}"
                                              FontAttributes="Bold" TextDecorations="Underline">
                                            <Span.GestureRecognizers>
                                                <TapGestureRecognizer Command="{x:Static phloem:AppNav.OpenParcelTermsCommand}" />
                                            </Span.GestureRecognizers>
                                        </Span>
                                        <Span Text="." />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>

                        <controls:StatusBanner Message="{Binding StatusMessage}" IsError="{Binding IsError}" />

                        <ActivityIndicator IsRunning="{Binding IsBooking}" IsVisible="{Binding IsBooking}"
                                           Color="{StaticResource BrandDark}" HeightRequest="28" />

                        <Button Text="Book parcel" Command="{Binding BookCommand}" IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource CtaButton}" HeightRequest="52" Margin="0,4,0,0" />
                        <!-- Need help? → Help & support -->
                        <Label FontSize="13" TextColor="{StaticResource BrandTextMuted}"
                               HorizontalTextAlignment="Center" Margin="8,4,8,0">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="💬 Questions about prices, weighing or customs? " />
                                    <Span Text="Help &amp; support ›" TextColor="{StaticResource BrandGreen}" FontAttributes="Bold">
                                        <Span.GestureRecognizers>
                                            <TapGestureRecognizer Command="{x:Static phloem:AppNav.OpenParcelHelpCommand}" />
                                        </Span.GestureRecognizers>
                                    </Span>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
