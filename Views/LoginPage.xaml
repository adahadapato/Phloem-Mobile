<?xml version="1.0" encoding="UTF-8" ?>
<!--
    LoginPage: redesigned to match "LoginPage.xaml / login / Proposed redesign".
    No AppHeaderBar: the green header is built into the page.
    Same LoginViewModel bindings and commands as before.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:phloem="clr-namespace:Phloem"
             xmlns:vm="clr-namespace:Phloem.ViewModels"
             xmlns:controls="clr-namespace:Phloem.Views.Controls"
             x:DataType="vm:LoginViewModel"
             x:Class="Phloem.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             Title="Log In">

    <ContentPage.Resources>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>
        <Style x:Key="FieldBox" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="{StaticResource BrandBorder}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HeightRequest" Value="48" />
        </Style>
        <Style x:Key="FieldEntry" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
            <Setter Property="PlaceholderColor" Value="{StaticResource BrandTextMuted}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ============ GREEN HEADER ============ -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource BrandDark}" HeightRequest="72">
            <Ellipse Stroke="#1AFFFFFF" StrokeThickness="10"
                     WidthRequest="320" HeightRequest="320"
                     HorizontalOptions="Start" VerticalOptions="Start"
                     Margin="-60,-30,0,0" InputTransparent="True" />

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="18,0,16,0">
                <Grid WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                    <Path Data="M2,5 L22,5 M2,12 L22,12 M2,19 L22,19"
                          Stroke="White" StrokeThickness="2.4" StrokeLineCap="Round"
                          WidthRequest="24" HeightRequest="24"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMenuTapped" />
                    </Grid.GestureRecognizers>
                </Grid>

                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{x:Static phloem:AppNav.GoHomeCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Image Source="header_logo.png" WidthRequest="34" HeightRequest="34" />
                    <Label Text="Phloem" TextColor="White" FontSize="22" FontAttributes="Bold"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border Grid.Column="2" BackgroundColor="White" StrokeThickness="0"
                        StrokeShape="RoundRectangle 16" Padding="10,3" HeightRequest="32"
                        VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="5">
                        <Label x:Name="FlagLabel" Text="🌍" FontSize="18" VerticalOptions="Center" />
                        <Path Data="M2,4 L6,8 L10,4" Stroke="{StaticResource BrandTextDark}"
                              StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round"
                              WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ BODY ============ -->
        <Grid Grid.Row="1">

            <!-- Soft mint circle behind the card (right side), like the design -->
            <Ellipse Fill="{StaticResource BrandMintPale}" WidthRequest="300" HeightRequest="300"
                     HorizontalOptions="End" VerticalOptions="Start"
                     Margin="0,-10,-110,0" InputTransparent="True" />

            <ScrollView>
                <VerticalStackLayout Padding="16,18,16,28" Spacing="16"
                                     MaximumWidthRequest="560" HorizontalOptions="Fill">

                    <!-- Title -->
                    <VerticalStackLayout Spacing="2" Margin="2,0,0,8">
                        <Label Text="Welcome back" FontSize="26" FontAttributes="Bold"
                               TextColor="{StaticResource BrandTextDark}" />
                        <Label Text="Sign in to continue to Phloem"
                               Style="{StaticResource SubtleLabel}" FontSize="13" />
                    </VerticalStackLayout>

                    <!-- ============ LOGIN CARD ============ -->
                    <Border BackgroundColor="White" StrokeThickness="0"
                            StrokeShape="RoundRectangle 18" Padding="18,20">
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.07" Radius="14" Offset="0,4" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="16">

                            <!-- Check badge + card title -->
                            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                                <Border StrokeThickness="0" StrokeShape="Ellipse"
                                        WidthRequest="64" HeightRequest="64"
                                        BackgroundColor="{StaticResource BrandMintPale}"
                                        HorizontalOptions="Center">
                                    <Path Data="M5,12.5 L10,17.5 L19,7"
                                          Stroke="{StaticResource BrandDark}" StrokeThickness="2.6"
                                          StrokeLineCap="Round" StrokeLineJoin="Round"
                                          WidthRequest="26" HeightRequest="26"
                                          HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="Log in to your account" FontSize="17" FontAttributes="Bold"
                                       TextColor="{StaticResource BrandTextDark}" HorizontalOptions="Center" />
                            </VerticalStackLayout>

                            <!-- Email -->
                            <VerticalStackLayout>
                                <Label Text="Email address" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource FieldBox}">
                                    <Entry Placeholder="you@example.com" Keyboard="Email" Text="{Binding Email}"
                                           Style="{StaticResource FieldEntry}" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- Password with show/hide eye -->
                            <VerticalStackLayout>
                                <Label Text="Password" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource FieldBox}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Entry x:Name="PasswordEntry" Placeholder="Your password" IsPassword="True"
                                               Text="{Binding Password}" Style="{StaticResource FieldEntry}" />
                                        <Grid Grid.Column="1" WidthRequest="32" HeightRequest="32" VerticalOptions="Center">
                                            <Path Data="M2,12 C5,6.5 8.5,4.5 12,4.5 C15.5,4.5 19,6.5 22,12 C19,17.5 15.5,19.5 12,19.5 C8.5,19.5 5,17.5 2,12 Z M9,12 A3,3 0 1 0 15,12 A3,3 0 1 0 9,12"
                                                  Stroke="{StaticResource BrandGreen}" StrokeThickness="1.8"
                                                  WidthRequest="22" HeightRequest="22"
                                                  HorizontalOptions="Center" VerticalOptions="Center" />
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnTogglePasswordTapped" />
                                            </Grid.GestureRecognizers>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Remember me + Forgot password -->
                            <Grid ColumnDefinitions="*,Auto">
                                <HorizontalStackLayout Spacing="2" Margin="-6,0,0,0">
                                    <CheckBox IsChecked="{Binding RememberMe}" Color="{StaticResource BrandGreen}"
                                              VerticalOptions="Center" />
                                    <Label Text="Remember me" FontSize="13"
                                           TextColor="{StaticResource BrandTextMuted}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Grid.Column="1" Text="Forgot password?" FontSize="13" FontAttributes="Bold"
                                       TextColor="{StaticResource BrandDark}" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>

                            <!-- Log in -->
                            <Button Text="Log in" Command="{Binding LoginCommand}"
                                    BackgroundColor="{StaticResource BrandDark}" TextColor="White"
                                    FontAttributes="Bold" FontSize="16" CornerRadius="12" HeightRequest="52" />

                            <!-- Or: Continue with Google (only when the API has Google switched on) -->
                            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsGoogleAvailable}">
                                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                                    <BoxView HeightRequest="1" Color="{StaticResource BrandBorder}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="or" FontSize="13"
                                           TextColor="{StaticResource BrandTextMuted}" VerticalOptions="Center" />
                                    <BoxView Grid.Column="2" HeightRequest="1" Color="{StaticResource BrandBorder}"
                                             VerticalOptions="Center" />
                                </Grid>
                                <!-- Google's rules: white button, their official "G" logo, "Continue with Google".
                                     Add the logo from Google's branding kit as Resources/Images/google_g.png, then
                                     add ImageSource="google_g.png" ContentLayout="Left,10" to this button. -->
                                <Button Text="Continue with Google" Command="{Binding ContinueWithGoogleCommand}"
                                        BackgroundColor="White" TextColor="#1F1F1F"
                                        BorderColor="#747775" BorderWidth="1"
                                        FontAttributes="Bold" FontSize="15" CornerRadius="12" HeightRequest="52" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <controls:StatusBanner Message="{Binding StatusMessage}" IsError="{Binding IsError}" />

                    <!-- ============ CREATE ACCOUNT ============ -->
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center" Margin="0,8,0,0">
                        <Label Text="New to Phloem?" FontSize="14"
                               TextColor="{StaticResource BrandTextMuted}" HorizontalOptions="Center" />
                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="Create an account" FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource BrandOrange}" VerticalOptions="Center" />
                            <Path Data="M2,8 L14,8 M9,3 L14,8 L9,13"
                                  Stroke="{StaticResource BrandOrange}" StrokeThickness="2"
                                  StrokeLineCap="Round" StrokeLineJoin="Round"
                                  WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                            </HorizontalStackLayout.GestureRecognizers>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
