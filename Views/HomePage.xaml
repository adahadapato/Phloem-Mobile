<?xml version="1.0" encoding="UTF-8" ?>
<!--
    HomePage: redesigned to match "Screen 01 / Home".
    Same HomeViewModel, same bindings and commands as before; only the layout and styling changed.
    Uses only Colors.xaml / Styles.xaml.
    Images used in the hero: home_page_wallpaper.png, hero_food_photo.png.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:phloem="clr-namespace:Phloem"
             xmlns:vm="clr-namespace:Phloem.ViewModels"
             xmlns:models="clr-namespace:Phloem.Models"
             x:DataType="vm:HomeViewModel"
             x:Class="Phloem.Views.HomePage"
             x:Name="RootPage"
             Shell.NavBarIsVisible="False"
             Title="Phloem">

    <ContentPage.Resources>
        <!-- A dish card in the suggestion rows: photo + rating, name, shop, why it was picked, price and "+" -->
        <DataTemplate x:Key="SuggestionCard" x:DataType="models:SuggestedDish">
            <Border Style="{StaticResource DishCard}" WidthRequest="170" Margin="0,0,0,8">
                <Grid RowDefinitions="110,Auto">
                    <Image Source="{Binding Dish.ImageUrl}" Aspect="AspectFill" />
                    <Border Style="{StaticResource RatingBadge}" HorizontalOptions="End" VerticalOptions="Start" Margin="8">
                        <Label FontSize="11" FontAttributes="Bold" TextColor="White">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="★ " TextColor="{StaticResource BrandStar}" />
                                    <Span Text="{Binding Dish.Rating, StringFormat='{0:0.0}'}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Border>

                    <Grid Grid.Row="1" Padding="10,8,10,10" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                        <Label Grid.ColumnSpan="2" Text="{Binding Dish.Name}" FontAttributes="Bold" FontSize="13"
                               TextColor="{StaticResource BrandTextDark}" MaxLines="1" LineBreakMode="TailTruncation" />
                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Dish.VendorName, StringFormat='🌿 {0}'}"
                               Style="{StaticResource SubtleLabel}" FontSize="10" MaxLines="1" LineBreakMode="TailTruncation" />
                        <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Reason}" IsVisible="{Binding HasReason}"
                               FontSize="10" FontAttributes="Bold" TextColor="{StaticResource BrandGreen}"
                               MaxLines="2" LineBreakMode="TailTruncation" Margin="0,3,0,0" />
                        <Label Grid.Row="3" Text="{Binding Dish.PriceText}" Style="{StaticResource PriceLabel}"
                               VerticalOptions="Center" Margin="0,4,0,0" />
                        <Button Grid.Row="3" Grid.Column="1" Text="+" Style="{StaticResource CircleIconButton}"
                                Command="{Binding BindingContext.AddToCartCommand, Source={x:Reference RootPage}}"
                                CommandParameter="{Binding Dish}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <!--
            The page scrolls UNDER a pinned header (menu, logo, basket, country, search), like the other pages.
            The header shows the top of the same wallpaper at the same size, so at rest the page looks unchanged.
        -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">

                <!-- ============ HERO: greeting on the wallpaper (the pinned header covers its top) ============ -->
                <Border HeightRequest="330"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 0,0,25,25"
                        BackgroundColor="{StaticResource BrandDark}">
                    <Grid RowDefinitions="120,*">   <!-- 120 = the pinned header's height (keep the two the same) -->

                        <!-- Wallpaper behind everything -->
                        <Image Grid.RowSpan="2" Source="home_page_wallpaper.png" Aspect="AspectFill" />

                        <!-- Darkens the left side so the white text stays readable -->
                        <BoxView Grid.RowSpan="2">
                            <BoxView.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#80012411" Offset="0.0" />
                                    <GradientStop Color="#00012411" Offset="0.75" />
                                </LinearGradientBrush>
                            </BoxView.Background>
                        </BoxView>

                        <!-- Row 0: room for the pinned header -->

                        <!-- Row 1: greeting left, round dish photo right (runs off the edge) -->
                        <Grid Grid.Row="1" ColumnDefinitions="1.2*,*" Padding="20,0,0,44">
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="Good to see you 👋" TextColor="White" FontSize="15" />
                                <Label Text="What are you craving today?" TextColor="White"
                                       FontSize="25" FontAttributes="Bold" LineHeight="1.0" />
                                <Label Text="Discover authentic African food from local vendors near you."
                                       TextColor="{StaticResource BrandGoldLight}" FontSize="12"
                                       Margin="0,2,0,0" />
                            </VerticalStackLayout>

                            <!-- Whole dish shown, nothing cropped -->
                            <Image Grid.Column="1" Source="hero_food_photo.png"
                                   Aspect="AspectFit" HeightRequest="190"
                                   HorizontalOptions="Fill" VerticalOptions="Center"
                                   Margin="0,0,-12,0" />
                        </Grid>
                    </Grid>
                </Border>

                <VerticalStackLayout Padding="16,0,16,16" Spacing="16"
                                     MaximumWidthRequest="900" HorizontalOptions="Fill">

                    <!-- ============ BUY / SELL CARDS (overlap the hero) ============ -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,-28,0,0">

                        <!-- Buy Food -->
                        <Border Grid.Column="0" Style="{StaticResource QuickActionCard}"
                                BackgroundColor="{StaticResource BrandMintPale}" Padding="10,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToBuyCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <!-- Icon -->
                                <Border Style="{StaticResource IconCircle}" BackgroundColor="{StaticResource BrandGreen}"
                                        WidthRequest="50" HeightRequest="50" VerticalOptions="Center">
                                    <Image Source="buy_food_basket.png" Aspect="AspectFit" Margin="6" />
                                </Border>
                                <!-- Title on top; subtitle + arrow underneath -->
                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto"
                                    ColumnSpacing="4" RowSpacing="1" VerticalOptions="Center">
                                    <Label Grid.ColumnSpan="2" Text="Buy Food" FontSize="16" FontAttributes="Bold"
                                            TextColor="{StaticResource BrandTextDark}"
                                            MaxLines="1" LineBreakMode="TailTruncation" />
                                    <Label Grid.Row="1" Text="Browse local vendors" FontSize="11"
                                            TextColor="{StaticResource BrandTextMuted}"
                                            MaxLines="2" LineBreakMode="WordWrap" VerticalOptions="Center" />
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ArrowCircle}"
                                             BackgroundColor="{StaticResource BrandMint}"
                                            WidthRequest="24" HeightRequest="24" StrokeShape="RoundRectangle 12"
                                            VerticalOptions="End">
                                        <Label Style="{StaticResource ArrowGlyph}" FontSize="16"
                                            TextColor="{StaticResource BrandGreen}" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Sell Food -->
                        <Border Grid.Column="1" Style="{StaticResource QuickActionCard}"
                                BackgroundColor="{StaticResource BrandPeach}" Padding="10,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToSellCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Style="{StaticResource IconCircle}" BackgroundColor="{StaticResource BrandOrangeLight}"
                                        WidthRequest="50" HeightRequest="50" VerticalOptions="Center">
                                    <Image Source="sell_food_shop.png" Aspect="AspectFit" Margin="6" />
                                </Border>
                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto"
                                      ColumnSpacing="4" RowSpacing="1" VerticalOptions="Center">
                                    <Label Grid.ColumnSpan="2" Text="Sell Food" FontSize="16" FontAttributes="Bold"
                                            TextColor="{StaticResource BrandTextDark}"
                                            MaxLines="1" LineBreakMode="TailTruncation" />
                                    <Label Grid.Row="1" Text="Start earning today" FontSize="11"
                                            TextColor="{StaticResource BrandTextMuted}"
                                            MaxLines="2" LineBreakMode="WordWrap" VerticalOptions="Center" />
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ArrowCircle}"
                                            BackgroundColor="White"
                                            WidthRequest="24" HeightRequest="24" StrokeShape="RoundRectangle 12"
                                            VerticalOptions="End">
                                        <Label Style="{StaticResource ArrowGlyph}" FontSize="16"
                                                TextColor="{StaticResource BrandOrange}" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ============ UK PROMO BANNER (image background) ============ -->
                    <Border StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="0"
                            HeightRequest="120">
                        <!-- Tapping anywhere on the banner opens Send Food to UK -->
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToSendToUkCommand}" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <!-- Background: the full banner image -->
                            <Image Source="global_shipping.png" Aspect="AspectFill" />

                            <!-- Text on top. The first column leaves the plane visible on the left. -->
                            <Grid ColumnDefinitions="90,*,Auto" ColumnSpacing="10" Padding="14,12">
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Free delivery on your first UK order" TextColor="White"
                                        FontAttributes="Bold" FontSize="16" />
                                    <Label Text="Send authentic African food straight to family in the diaspora."
                                        TextColor="White" FontSize="12" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" Style="{StaticResource ArrowCircle}" BackgroundColor="#33FFFFFF">
                                    <Label Style="{StaticResource ArrowGlyph}" TextColor="White" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ============ ORDER AGAIN (signed in, after a first order) ============ -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding HasOrderAgain}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Order again" Style="{StaticResource SectionTitle}" />
                            <Label Grid.Column="1" Text="My orders ›" Style="{StaticResource LinkLabel}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToMyOrdersCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                        <CollectionView ItemsSource="{Binding OrderAgain}" HeightRequest="232"
                                        ItemTemplate="{StaticResource SuggestionCard}">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                            </CollectionView.ItemsLayout>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- ============ YOU MIGHT LIKE / POPULAR IN … (each card says why) ============ -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding HasForYou}">
                        <Label Text="{Binding ForYouTitle}" Style="{StaticResource SectionTitle}" />
                        <CollectionView ItemsSource="{Binding ForYou}" HeightRequest="262"
                                        ItemTemplate="{StaticResource SuggestionCard}">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                            </CollectionView.ItemsLayout>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- ============ CATEGORY CHIPS ============ -->
                    <CollectionView ItemsSource="{Binding Categories}" SelectionMode="Single"
                                    SelectedItem="{Binding SelectedCategory}" HeightRequest="40">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border x:Name="PillBorder" Style="{StaticResource ChipBorder}">
                                    <Label x:Name="PillText" Text="{Binding .}" Style="{StaticResource PillLabel}" />
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter TargetName="PillBorder" Property="Border.BackgroundColor" Value="{StaticResource BrandGreen}" />
                                                    <Setter TargetName="PillBorder" Property="Border.Stroke" Value="{StaticResource BrandGreen}" />
                                                    <Setter TargetName="PillText" Property="Label.TextColor" Value="White" />
                                                    <Setter TargetName="PillText" Property="Label.FontAttributes" Value="Bold" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- ============ POPULAR DISHES (2-column grid) ============ -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Popular Dishes" Style="{StaticResource SectionTitle}" />
                        <Label Grid.Column="1" Text="See all ›" Style="{StaticResource LinkLabel}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToBuyCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- BindableLayout so the grid grows inside the ScrollView without a fixed height. -->
                    <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="SpaceBetween"
                                BindableLayout.ItemsSource="{Binding FeaturedDishes}"
                                Margin="-6,0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Dish">
                                <ContentView FlexLayout.Basis="50%" Padding="6,0,6,12">
                                    <Border Style="{StaticResource DishCard}">
                                        <Grid RowDefinitions="120,Auto">
                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                            <Border Style="{StaticResource RatingBadge}"
                                                    HorizontalOptions="End" VerticalOptions="Start" Margin="8">
                                                <Label FontSize="11" FontAttributes="Bold" TextColor="White">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="★ " TextColor="{StaticResource BrandStar}" />
                                                            <Span Text="{Binding Rating, StringFormat='{0:0.0}'}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </Border>

                                            <Grid Grid.Row="1" Padding="10,8,10,10"
                                                  ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="13"
                                                       TextColor="{StaticResource BrandTextDark}"
                                                       MaxLines="1" LineBreakMode="TailTruncation" />
                                                <Label Grid.Row="1" Text="{Binding VendorName, StringFormat='🌿 {0}'}"
                                                       Style="{StaticResource SubtleLabel}" FontSize="10"
                                                       MaxLines="1" LineBreakMode="TailTruncation" />
                                                <Label Grid.Row="2" Text="{Binding PriceText}"
                                                       Style="{StaticResource PriceLabel}" Margin="0,4,0,0" />
                                                <Button Grid.Column="1" Grid.Row="1" Grid.RowSpan="2"
                                                        Text="+" Style="{StaticResource CircleIconButton}" VerticalOptions="End"
                                                        Command="{Binding BindingContext.AddToCartCommand, Source={x:Reference RootPage}}"
                                                        CommandParameter="{Binding .}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </ContentView>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <!-- No dishes, or the API couldn't be reached -->
                    <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                       Color="{StaticResource BrandGreen}" HeightRequest="28" />
                    <Label Text="{Binding DishesMessage}" Style="{StaticResource SubtleLabel}"
                           HorizontalTextAlignment="Center"
                           IsVisible="{Binding DishesMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                    <!-- ============ TOP SELLERS ============ -->
                    <Label Text="Top Sellers" Style="{StaticResource SectionTitle}" />

                    <CollectionView ItemsSource="{Binding TopSellers}" HeightRequest="200">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Vendor">
                                <Border Style="{StaticResource VendorCard}" WidthRequest="165" Margin="0,0,0,8">
                                    <VerticalStackLayout Spacing="0">

                                        <Grid HeightRequest="64">
                                            <BoxView>
                                                <BoxView.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="{StaticResource BrandLeafGreen}" Offset="0.0" />
                                                        <GradientStop Color="{StaticResource BrandHeroGreen}" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </BoxView.Background>
                                            </BoxView>
                                            <!-- The shop's cover photo (from the API) over the green -->
                                            <Image Source="{Binding CoverPhotoUrl}" Aspect="AspectFill" />

                                            <Border Style="{StaticResource RatingBadge}" HorizontalOptions="Start"
                                                    VerticalOptions="Start" Margin="8" IsVisible="{Binding IsVerified}">
                                                <Label Text="✓ Verified" TextColor="White" FontSize="10" FontAttributes="Bold" />
                                            </Border>

                                            <Border Style="{StaticResource RatingBadge}" HorizontalOptions="End"
                                                    VerticalOptions="Start" Margin="8">
                                                <Label FontSize="11" FontAttributes="Bold" TextColor="White">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="★ " TextColor="{StaticResource BrandStar}" />
                                                            <Span Text="{Binding Rating, StringFormat='{0:0.0}'}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </Border>

                                            <Border StrokeShape="RoundRectangle 28" Stroke="White" StrokeThickness="3"
                                                    WidthRequest="56" HeightRequest="56" VerticalOptions="End"
                                                    Margin="0,0,0,-28" BackgroundColor="{StaticResource BrandCream}">
                                                <Image Source="{Binding LogoUrl}" Aspect="AspectFit" Margin="6" />
                                            </Border>
                                        </Grid>

                                        <VerticalStackLayout Spacing="8" Padding="12,34,12,0">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="14"
                                                   TextColor="{StaticResource BrandTextDark}"
                                                   HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                            <Button Text="View Shop" Style="{StaticResource OutlineButton}"
                                                    FontSize="12" HeightRequest="34"
                                                    Command="{Binding BindingContext.ViewShopCommand, Source={x:Reference RootPage}}"
                                                    CommandParameter="{Binding .}" />
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ============ PINNED HEADER: menu, logo, basket, country + search (never scrolls) ============ -->
        <!-- 120 high: the same as the hero's first row (keep the two the same) -->
        <Grid Grid.Row="0" VerticalOptions="Start" HeightRequest="120" RowDefinitions="Auto,Auto,*"
              BackgroundColor="{StaticResource BrandDark}">

            <!-- Same wallpaper at the hero's size (full width × 330), cut to the header, so the two line up exactly -->
            <AbsoluteLayout Grid.RowSpan="3" HeightRequest="120" IsClippedToBounds="True" InputTransparent="True">
                <Image Source="home_page_wallpaper.png" Aspect="AspectFill"
                       AbsoluteLayout.LayoutBounds="0,0,1,330" AbsoluteLayout.LayoutFlags="WidthProportional" />
                <BoxView AbsoluteLayout.LayoutBounds="0,0,1,330" AbsoluteLayout.LayoutFlags="WidthProportional">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#80012411" Offset="0.0" />
                            <GradientStop Color="#00012411" Offset="0.75" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
            </AbsoluteLayout>

            <!-- Row 0: menu, logo + name, country flag pill -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14"
                  Padding="18,14,16,10">
                <!-- Menu icon (opens the side menu) -->
                <Grid WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                    <Path Data="M2,5 L22,5 M2,12 L22,12 M2,19 L22,19"
                          Stroke="White" StrokeThickness="2.4" StrokeLineCap="Round"
                          WidthRequest="24" HeightRequest="24"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMenuTapped" />
                    </Grid.GestureRecognizers>
            </Grid>

                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{x:Static phloem:AppNav.GoHomeCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Image Source="header_logo.png" WidthRequest="36" HeightRequest="36" />
                    <Label Text="Phloem" TextColor="White" FontSize="22" FontAttributes="Bold"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- Cart icon + count (shows once something is in the basket) -->
                <Grid Grid.Column="2" WidthRequest="40" HeightRequest="40" VerticalOptions="Center"
                      IsVisible="{Binding CartCount, Converter={StaticResource IntToBoolConverter}}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCartTapped" />
                    </Grid.GestureRecognizers>
                    <Path Data="M2.5,4 L5.5,4 L7.9,14.5 L18.1,14.5 L20.5,7 L7,7 M9.5,19 A1.6,1.6 0 1 0 9.51,19 M16.5,19 A1.6,1.6 0 1 0 16.51,19"
                          Stroke="White" StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round"
                          WidthRequest="26" HeightRequest="26"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border BackgroundColor="{StaticResource BrandOrangeLight}" Stroke="{StaticResource BrandDark}"
                            StrokeThickness="2" StrokeShape="RoundRectangle 10"
                            MinimumWidthRequest="20" HeightRequest="20" Padding="5,0"
                            HorizontalOptions="End" VerticalOptions="Start" Margin="0,-2,-4,0">
                        <Label Text="{Binding CartCount}" TextColor="White" FontSize="11" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Country pill -->
                <Border Grid.Column="3" BackgroundColor="White" StrokeThickness="0"
                        StrokeShape="RoundRectangle 18" Padding="12,4" HeightRequest="36"
                        VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{Binding SelectedCountry.FlagEmoji}" FontSize="20" VerticalOptions="Center" />
                        <Path Data="M2,4 L6,8 L10,4" Stroke="{StaticResource BrandTextDark}"
                              StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round"
                              WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCountryTapped" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>

            <!-- Row 1: white rounded search bar -->
            <Border Grid.Row="1" Margin="16,0,16,0" HeightRequest="46"
                    BackgroundColor="{StaticResource BrandCard}"
                    StrokeThickness="0" StrokeShape="RoundRectangle 12"
                    Padding="14,0">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.15" Radius="10" Offset="0,3" />
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                    <Path Data="M3,10 A7,7 0 1 0 17,10 A7,7 0 1 0 3,10 M15.5,15.5 L21,21"
                          Stroke="{StaticResource BrandTextDark}" StrokeThickness="2"
                          StrokeLineCap="Round"
                          WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                    <Entry Grid.Column="1"
                           Text="{Binding SearchText}"
                           Placeholder="Search meals, ingredients, or vendors..."
                           PlaceholderColor="{StaticResource BrandTextMuted}"
                           TextColor="{StaticResource BrandTextDark}"
                           BackgroundColor="Transparent"
                           FontSize="14" ReturnType="Search" ReturnCommand="{Binding SearchNowCommand}"
                           VerticalOptions="Center" />
                    <BoxView Grid.Column="2" WidthRequest="1" HeightRequest="24"
                             Color="{StaticResource BrandBorder}" VerticalOptions="Center" />
                    <Path Grid.Column="3"
                          Data="M3,6 L21,6 M3,12 L21,12 M3,18 L21,18 M7,4 L7,8 M16,10 L16,14 M10,16 L10,20"
                          Stroke="{StaticResource BrandTextDark}" StrokeThickness="2"
                          StrokeLineCap="Round"
                          WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- ============ SEARCH PREDICTIONS (under the search bar, over the page) ============ -->
        <Border Grid.Row="0" VerticalOptions="Start" Margin="16,114,16,0" Padding="6"
                IsVisible="{Binding HasPredictions}" BackgroundColor="White"
                Stroke="{StaticResource BrandBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 14">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.18" Radius="16" Offset="0,6" />
            </Border.Shadow>
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Predictions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:SearchPrediction">
                        <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="10" Padding="8,0" HeightRequest="46">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.PickPredictionCommand, Source={x:Reference RootPage}}"
                                                      CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <Border WidthRequest="30" HeightRequest="30" StrokeThickness="0" StrokeShape="Ellipse"
                                    BackgroundColor="{StaticResource BrandCream}" VerticalOptions="Center">
                                <Label Text="{Binding Icon}" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" FontSize="15" TextColor="{StaticResource BrandTextDark}"
                                   VerticalOptions="Center" MaxLines="1" LineBreakMode="TailTruncation">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Before}" />
                                        <Span Text="{Binding Match}" FontAttributes="Bold" TextColor="{StaticResource BrandGreen}" />
                                        <Span Text="{Binding After}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Grid.Column="2" Text="{Binding Meta}" FontSize="11"
                                   TextColor="{StaticResource BrandTextMuted}" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </Border>

        <!-- ============ CHECKOUT BAR ============ -->
        <Border Grid.Row="1"
                IsVisible="{Binding CartCount, Converter={StaticResource IntToBoolConverter}}"
                BackgroundColor="{StaticResource BrandDark}"
                StrokeThickness="0" StrokeShape="RoundRectangle 16"
                Margin="16,0,16,12" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="Your basket" FontSize="12" TextColor="{StaticResource BrandGoldLight}" />
                    <Label Text="{Binding CartCount, StringFormat='{0} item(s)'}" FontSize="17"
                           FontAttributes="Bold" TextColor="White" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Checkout  ›" Style="{StaticResource CtaButton}"
                        HeightRequest="42" FontSize="15" Padding="18,0"
                        Command="{Binding GoToCheckoutCommand}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
