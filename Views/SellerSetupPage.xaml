<?xml version="1.0" encoding="UTF-8" ?>
<!--
    SellerSetupPage: redesigned to match "SellerSetupPage.xaml / sellersetup / Proposed redesign".
    No AppHeaderBar: the green header is built into the page.
    Same SellerSetupViewModel bindings and commands as before.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:phloem="clr-namespace:Phloem"
             xmlns:vm="clr-namespace:Phloem.ViewModels"
             xmlns:controls="clr-namespace:Phloem.Views.Controls"
             x:DataType="vm:SellerSetupViewModel"
             x:Class="Phloem.Views.SellerSetupPage"
             Shell.NavBarIsVisible="False"
             Title="Become a Seller">

    <ContentPage.Resources>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>
        <Style x:Key="FieldBox" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="{StaticResource BrandBorder}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HeightRequest" Value="48" />
        </Style>
        <Style x:Key="FieldEntry" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
            <Setter Property="PlaceholderColor" Value="{StaticResource BrandTextMuted}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ============ GREEN HEADER ============ -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource BrandDark}" HeightRequest="72">
            <Ellipse Stroke="#1AFFFFFF" StrokeThickness="10"
                     WidthRequest="320" HeightRequest="320"
                     HorizontalOptions="Start" VerticalOptions="Start"
                     Margin="-60,-30,0,0" InputTransparent="True" />

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="18,0,16,0">
                <Grid WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                    <Path Data="M2,5 L22,5 M2,12 L22,12 M2,19 L22,19"
                          Stroke="White" StrokeThickness="2.4" StrokeLineCap="Round"
                          WidthRequest="24" HeightRequest="24"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMenuTapped" />
                    </Grid.GestureRecognizers>
                </Grid>

                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{x:Static phloem:AppNav.GoHomeCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Image Source="header_logo.png" WidthRequest="34" HeightRequest="34" />
                    <Label Text="Phloem" TextColor="White" FontSize="22" FontAttributes="Bold"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border Grid.Column="2" BackgroundColor="White" StrokeThickness="0"
                        StrokeShape="RoundRectangle 16" Padding="10,3" HeightRequest="32"
                        VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="5">
                        <Label x:Name="FlagLabel" Text="🌍" FontSize="18" VerticalOptions="Center" />
                        <Path Data="M2,4 L6,8 L10,4" Stroke="{StaticResource BrandTextDark}"
                              StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round"
                              WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,18,16,28" Spacing="14"
                                 MaximumWidthRequest="560" HorizontalOptions="Fill">

                <!-- ============ TITLE ============ -->
                <VerticalStackLayout Spacing="2" Margin="2,0,0,0">
                    <Label Text="Become a seller" FontSize="26" FontAttributes="Bold"
                           TextColor="{StaticResource BrandTextDark}" />
                    <Label Text="Turn your cooking into a business"
                           Style="{StaticResource SubtleLabel}" FontSize="13" />
                </VerticalStackLayout>

                <!-- ============ SIGN-IN NOTICE (not logged in) ============ -->
                <Border BackgroundColor="{StaticResource BrandMintPale}" Stroke="{StaticResource BrandMint}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="14,12"
                        IsVisible="{Binding IsLoggedIn, Converter={StaticResource InvertedBoolConverter}}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label FontSize="15" FontAttributes="Bold" TextColor="{StaticResource BrandDark}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="✓  " />
                                        <Span Text="Sign in before creating a shop" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Style="{StaticResource SubtleLabel}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Your store goes live after approval. By opening a shop you agree to the " />
                                        <Span Text="Seller terms" TextColor="{StaticResource BrandGreen}"
                                              FontAttributes="Bold" TextDecorations="Underline">
                                            <Span.GestureRecognizers>
                                                <TapGestureRecognizer Command="{x:Static phloem:AppNav.OpenSellerTermsCommand}" />
                                            </Span.GestureRecognizers>
                                        </Span>
                                        <Span Text="." />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Log in" Command="{Binding GoToLoginCommand}"
                                BackgroundColor="{StaticResource BrandDark}" TextColor="White"
                                FontAttributes="Bold" FontSize="13" CornerRadius="10"
                                HeightRequest="36" Padding="16,0" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- ============ SIGNED-IN NOTICE (logged in) ============ -->
                <Border BackgroundColor="{StaticResource BrandMintPale}" Stroke="{StaticResource BrandMint}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="14,12"
                        IsVisible="{Binding IsLoggedIn}">
                    <VerticalStackLayout Spacing="2">
                        <Label FontSize="15" FontAttributes="Bold" TextColor="{StaticResource BrandDark}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="✓  " />
                                    <Span Text="You're signed in" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Text="{Binding LoggedInAsText}" Style="{StaticResource SubtleLabel}" />
                        <Label Style="{StaticResource SubtleLabel}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Your store goes live after approval. By opening a shop you agree to the " />
                                        <Span Text="Seller terms" TextColor="{StaticResource BrandGreen}"
                                              FontAttributes="Bold" TextDecorations="Underline">
                                            <Span.GestureRecognizers>
                                                <TapGestureRecognizer Command="{x:Static phloem:AppNav.OpenSellerTermsCommand}" />
                                            </Span.GestureRecognizers>
                                        </Span>
                                        <Span Text="." />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ PERSONAL DETAILS NEEDED (signed in, none yet) ============ -->
                <Border BackgroundColor="{StaticResource BrandPeach}" Stroke="{StaticResource BrandGold}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="14,12"
                        IsVisible="{Binding NeedsPersonalDetails}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Add your personal details first" FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource BrandTextDark}" />
                            <Label Text="Your date of birth and home address. Sellers must be 18 or over."
                                   Style="{StaticResource SubtleLabel}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Add" Command="{Binding AddPersonalDetailsCommand}"
                                BackgroundColor="{StaticResource BrandDark}" TextColor="White"
                                FontAttributes="Bold" FontSize="13" CornerRadius="10"
                                HeightRequest="36" Padding="18,0" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- ============ FORM CARD ============ -->
                <Border BackgroundColor="White" StrokeThickness="0"
                        StrokeShape="RoundRectangle 18" Padding="16,16,16,20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.06" Radius="12" Offset="0,3" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">

                        <!-- Upload shop logo -->
                        <Border BackgroundColor="{StaticResource BrandMintPale}" Stroke="{StaticResource BrandMint}"
                                StrokeThickness="1.5" StrokeShape="RoundRectangle 14" Padding="12,18">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PickLogoCommand}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Border StrokeThickness="0" StrokeShape="Ellipse" WidthRequest="40" HeightRequest="40"
                                        BackgroundColor="{StaticResource BrandMint}" HorizontalOptions="Center">
                                    <Path Data="M10,16 L10,4 M5,9 L10,4 L15,9"
                                          Stroke="{StaticResource BrandDark}" StrokeThickness="2.2"
                                          StrokeLineCap="Round" StrokeLineJoin="Round"
                                          WidthRequest="20" HeightRequest="20"
                                          HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="Upload shop logo" FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource BrandDark}" HorizontalOptions="Center" />
                                <!-- Picked file name -->
                                <Label Text="{Binding LogoFileName, StringFormat='✓ {0}'}" FontSize="12"
                                       TextColor="{StaticResource BrandGreen}" HorizontalOptions="Center"
                                       LineBreakMode="MiddleTruncation"
                                       IsVisible="{Binding LogoFileName, Converter={StaticResource StringNotEmptyConverter}}" />
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout>
                            <Label Text="Business name" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBox}">
                                <Entry Placeholder="e.g. Mama Abena's Kitchen" Text="{Binding BusinessName}"
                                       Style="{StaticResource FieldEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="Business email (optional)" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBox}">
                                <Entry Placeholder="business@example.com" Keyboard="Email" Text="{Binding BusinessEmail}"
                                       Style="{StaticResource FieldEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="Business phone (optional)" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBox}">
                                <Entry Placeholder="+44 7xxx xxx xxx" Keyboard="Telephone" Text="{Binding BusinessPhone}"
                                       Style="{StaticResource FieldEntry}" />
                            </Border>
                            <Label Text="Leave email and phone blank to use your account details."
                                   Style="{StaticResource SubtleLabel}" FontSize="11" Margin="2,6,0,0" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ SUBMIT ============ -->
                <Button Text="Submit seller profile" Command="{Binding CreateVendorProfileCommand}"
                        Style="{StaticResource CtaButton}" HeightRequest="52" Margin="0,6,0,0" />
                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource BrandDark}" HeightRequest="28" />
                <Label Text="Phloem reviews new shops. Next, you'll upload your documents in Shop settings."
                       Style="{StaticResource SubtleLabel}" FontSize="12" HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" Margin="0,-6,0,0" />

                <controls:StatusBanner Message="{Binding StatusMessage}" IsError="{Binding IsError}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
