<?xml version="1.0" encoding="UTF-8" ?>
<!--
    AdminPage: the admin dashboard, from the API (AdminViewModel).
      Sellers:   waiting for approval (Approve / Reject), dish name suggestions, every shop WITH ITS LOGO
                 (✓ badge, Block / Unblock, Details → documents)
      Users:     search, "suspended only", Roles (give / take Admin and staff roles), Suspend (how long + why) / Lift suspension
      Shipments: Shipping routes and All shipments
    No AppHeaderBar: the green header is built into the page.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:phloem="clr-namespace:Phloem"
             xmlns:vm="clr-namespace:Phloem.ViewModels"
             xmlns:models="clr-namespace:Phloem.Models"
             xmlns:controls="clr-namespace:Phloem.Views.Controls"
             x:DataType="vm:AdminViewModel"
             x:Class="Phloem.Views.AdminPage"
             x:Name="RootPage"
             Shell.NavBarIsVisible="False"
             Title="Admin Dashboard">

    <ContentPage.Resources>
        <!-- White card -->
        <Style x:Key="WhiteCard" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="Black" Opacity="0.06" Radius="10" Offset="0,3" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TileNumber" TargetType="Label">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource BrandDark}" />
        </Style>
        <Style x:Key="TileCaption" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextMuted}" />
        </Style>
        <!-- Sellers / Users / Shipments pills -->
        <Style x:Key="TabPill" TargetType="Button">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
            <Setter Property="BorderColor" Value="{StaticResource BrandBorder}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HeightRequest" Value="36" />
            <Setter Property="Padding" Value="20,0" />
        </Style>
        <!-- Small Approve / Reject chips -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HeightRequest" Value="30" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="BorderWidth" Value="0" />
        </Style>
        <Style x:Key="SmallSubtle" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextMuted}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ============ GREEN HEADER ============ -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource BrandDark}" HeightRequest="72">
            <Ellipse Stroke="#1AFFFFFF" StrokeThickness="10"
                     WidthRequest="320" HeightRequest="320"
                     HorizontalOptions="Start" VerticalOptions="Start"
                     Margin="-60,-30,0,0" InputTransparent="True" />

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="18,0,16,0">
                <Grid WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                    <Path Data="M2,5 L22,5 M2,12 L22,12 M2,19 L22,19"
                          Stroke="White" StrokeThickness="2.4" StrokeLineCap="Round"
                          WidthRequest="24" HeightRequest="24"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMenuTapped" />
                    </Grid.GestureRecognizers>
                </Grid>

                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{x:Static phloem:AppNav.GoHomeCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Image Source="header_logo.png" WidthRequest="34" HeightRequest="34" />
                    <Label Text="Phloem" TextColor="White" FontSize="22" FontAttributes="Bold"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border Grid.Column="2" BackgroundColor="White" StrokeThickness="0"
                        StrokeShape="RoundRectangle 16" Padding="10,3" HeightRequest="32"
                        VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="5">
                        <Label x:Name="FlagLabel" Text="🌍" FontSize="18" VerticalOptions="Center" />
                        <Path Data="M2,4 L6,8 L10,4" Stroke="{StaticResource BrandTextDark}"
                              StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round"
                              WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,18,16,28" Spacing="14"
                                 MaximumWidthRequest="700" HorizontalOptions="Fill">

                <!-- ============ TITLE ============ -->
                <VerticalStackLayout Spacing="2" Margin="2,0,0,2">
                    <Label Text="Admin dashboard" FontSize="26" FontAttributes="Bold"
                           TextColor="{StaticResource BrandTextDark}" />
                    <Label Text="Manage the Phloem marketplace" Style="{StaticResource SubtleLabel}" FontSize="13" />
                </VerticalStackLayout>

                <!-- ============ STATS (2 × 2) ============ -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource WhiteCard}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding TotalVendors, StringFormat='{0:N0}'}" Style="{StaticResource TileNumber}" />
                            <Label Text="Total sellers" Style="{StaticResource TileCaption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource WhiteCard}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding TotalUsers, StringFormat='{0:N0}'}" Style="{StaticResource TileNumber}" />
                            <Label Text="Total users" Style="{StaticResource TileCaption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource WhiteCard}"
                            BackgroundColor="{StaticResource BrandMintPale}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding PendingApprovalCount}" Style="{StaticResource TileNumber}"
                                   TextColor="{StaticResource BrandOrange}" />
                            <Label Text="Pending reviews" Style="{StaticResource TileCaption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource WhiteCard}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding TotalShipments}" Style="{StaticResource TileNumber}" />
                            <Label Text="Shipments" Style="{StaticResource TileCaption}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- ============ TAB PILLS ============ -->
                <HorizontalStackLayout Spacing="8" Margin="0,6,0,0">
                    <Button Text="Sellers" Style="{StaticResource TabPill}" Command="{Binding ShowSellersCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ActiveTab}" Value="Sellers">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandDark}" />
                                <Setter Property="BorderColor" Value="{StaticResource BrandDark}" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="FontAttributes" Value="Bold" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Users" Style="{StaticResource TabPill}" Command="{Binding ShowUsersCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ActiveTab}" Value="Users">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandDark}" />
                                <Setter Property="BorderColor" Value="{StaticResource BrandDark}" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="FontAttributes" Value="Bold" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="Shipments" Style="{StaticResource TabPill}" Command="{Binding ShowShipmentsCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ActiveTab}" Value="Shipments">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandDark}" />
                                <Setter Property="BorderColor" Value="{StaticResource BrandDark}" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="FontAttributes" Value="Bold" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </HorizontalStackLayout>

                <controls:StatusBanner Message="{Binding StatusMessage}" IsError="{Binding IsError}" />
                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource BrandDark}" HeightRequest="28" />

                <!-- =================================================== -->
                <!-- ================ SELLERS TAB ====================== -->
                <!-- =================================================== -->
                <VerticalStackLayout Spacing="12" IsVisible="False">
                    <VerticalStackLayout.Triggers>
                        <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding ActiveTab}" Value="Sellers">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </VerticalStackLayout.Triggers>

                    <!-- ============ WAITING FOR APPROVAL ============ -->
                    <Label Text="Waiting for approval" Style="{StaticResource SectionTitle}" Margin="2,4,0,0" />
                    <Label Text="No shops waiting for approval." Style="{StaticResource SubtleLabel}"
                           IsVisible="{Binding HasPendingApprovals, Converter={StaticResource InvertedBoolConverter}}" />

                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding PendingShops}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:AdminShopCard">
                                <Border Style="{StaticResource WhiteCard}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                            <!-- Shop logo (top-left) -->
                                            <Border StrokeThickness="1" Stroke="{StaticResource BrandBorder}" StrokeShape="Ellipse"
                                                    WidthRequest="48" HeightRequest="48" VerticalOptions="Start"
                                                    BackgroundColor="White">
                                                <Image Source="{Binding LogoUrl}" Aspect="AspectFill" />
                                            </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                                            <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold"
                                                   TextColor="{StaticResource BrandTextDark}" />
                                            <Label Text="{Binding OwnerText}" Style="{StaticResource SmallSubtle}" />
                                            <Label Style="{StaticResource SmallSubtle}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding CountryText}" />
                                                        <Span Text="  ·  " />
                                                        <Span Text="{Binding OpenedText}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label Text="{Binding EmailText}" Style="{StaticResource SmallSubtle}" FontSize="11" />
                                            <HorizontalStackLayout Spacing="8" Margin="0,6,0,0">
                                                <Button Text="Approve" Style="{StaticResource ChipButton}"
                                                        BackgroundColor="{StaticResource BrandMint}" TextColor="{StaticResource BrandDark}"
                                                        Command="{Binding ApproveShopCommand, Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}}"
                                                        CommandParameter="{Binding .}" />
                                                <Button Text="Reject" Style="{StaticResource ChipButton}"
                                                        BackgroundColor="{StaticResource BrandPeach}" TextColor="{StaticResource BrandOrange}"
                                                        Command="{Binding RejectShopCommand, Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}}"
                                                        CommandParameter="{Binding .}" />
                                                <Button Text="Details" Style="{StaticResource ChipButton}"
                                                        BackgroundColor="White" TextColor="{StaticResource BrandDark}"
                                                        BorderColor="{StaticResource BrandBorder}" BorderWidth="1"
                                                        Command="{Binding OpenShopCommand, Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}}"
                                                        CommandParameter="{Binding .}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- ============ DISH NAMES & PRICES ============ -->
                    <Border Style="{StaticResource WhiteCard}" Margin="0,10,0,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenDishNamesCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource BrandMintPale}" VerticalOptions="Center">
                                <Label Text="🍲" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Dish names &amp; prices" FontSize="16" FontAttributes="Bold"
                                       TextColor="{StaticResource BrandTextDark}" />
                                <Label Text="The allowed price for each dish name in each country"
                                       Style="{StaticResource SmallSubtle}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="26" TextColor="{StaticResource BrandTextMuted}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- ============ PRICING ============ -->
                    <Border Style="{StaticResource WhiteCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenPricingCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource BrandMintPale}" VerticalOptions="Center">
                                <Label Text="💷" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Pricing" FontSize="16" FontAttributes="Bold"
                                       TextColor="{StaticResource BrandTextDark}" />
                                <Label Text="Commission, shop delivery fees and delivery times in each country"
                                       Style="{StaticResource SmallSubtle}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="26" TextColor="{StaticResource BrandTextMuted}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- ============ DISH NAME SUGGESTIONS ============ -->
                    <VerticalStackLayout Spacing="12" Margin="0,10,0,0" IsVisible="{Binding HasDishSuggestions}">
                        <Label Text="Dish name suggestions" Style="{StaticResource SectionTitle}" Margin="2,4,0,0" />
                        <Label Text="Approved names join the list sellers choose from (once they have a price range)."
                               Style="{StaticResource SmallSubtle}" Margin="2,-8,0,0" />
                        <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding DishSuggestions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:DishSuggestionCard">
                                    <Border Style="{StaticResource WhiteCard}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                            <Border StrokeThickness="0" StrokeShape="Ellipse"
                                                    WidthRequest="44" HeightRequest="44" VerticalOptions="Center"
                                                    BackgroundColor="{StaticResource BrandPeach}">
                                                <Label Text="🍲" FontSize="18"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                                <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold"
                                                       TextColor="{StaticResource BrandTextDark}" />
                                                <Label Text="{Binding DetailsText}" Style="{StaticResource SmallSubtle}" />
                                                <HorizontalStackLayout Spacing="8" Margin="0,6,0,0">
                                                    <Button Text="Approve" Style="{StaticResource ChipButton}"
                                                            BackgroundColor="{StaticResource BrandMint}" TextColor="{StaticResource BrandDark}"
                                                            Command="{Binding ApproveDishNameCommand, Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}}"
                                                            CommandParameter="{Binding .}" />
                                                    <Button Text="Reject" Style="{StaticResource ChipButton}"
                                                            BackgroundColor="{StaticResource BrandPeach}" TextColor="{StaticResource BrandOrange}"
                                                            Command="{Binding RejectDishNameCommand, Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}}"
                                                            CommandParameter="{Binding .}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- ============ ALL SHOPS ============ -->
                    <Grid ColumnDefinitions="*,Auto" Margin="2,14,0,0">
                        <Label x:Name="AllShopsTitle" Text="All shops" Style="{StaticResource SectionTitle}" />
                        <Label Grid.Column="1" Text="{Binding BlockedCount, StringFormat='{0} blocked'}"
                               FontSize="12" FontAttributes="Bold" TextColor="{StaticResource BrandDanger}"
                               VerticalOptions="Center" />
                    </Grid>
                    <Border BackgroundColor="White" Stroke="{StaticResource BrandBorder}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 12" Padding="12,0" HeightRequest="44">
                        <Entry Text="{Binding ShopSearch}" Placeholder="Search shops by name" ReturnType="Search"
                               ReturnCommand="{Binding SearchShopsCommand}" VerticalOptions="Center"
                               TextColor="{StaticResource BrandTextDark}" />
                    </Border>

                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Shops}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:AdminShopCard">
                                <Border BackgroundColor="White" Stroke="{StaticResource BrandBorder}" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 16" Padding="14,12">
                                    <VerticalStackLayout Spacing="10">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <!-- Shop logo (top-left) -->
                                            <Border StrokeThickness="1" Stroke="{StaticResource BrandBorder}" StrokeShape="Ellipse"
                                                    WidthRequest="48" HeightRequest="48" VerticalOptions="Start"
                                                    BackgroundColor="White">
                                                <Image Source="{Binding LogoUrl}" Aspect="AspectFill" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold"
                                                           TextColor="{StaticResource BrandTextDark}" VerticalOptions="Center" />
                                                    <Label Text="✓" FontSize="14" FontAttributes="Bold"
                                                           TextColor="{StaticResource BrandGreen}" VerticalOptions="Center"
                                                           IsVisible="{Binding IsVerified}" />
                                                </HorizontalStackLayout>
                                                <HorizontalStackLayout Spacing="8">
                                                <!-- Status chip -->
                                                <Border BackgroundColor="{StaticResource BrandMintPale}" StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 6" Padding="6,2" VerticalOptions="Center">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsBad}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="#FDECEA" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Label Text="{Binding StatusText}" FontSize="10" FontAttributes="Bold"
                                                           TextColor="{StaticResource BrandDark}" />
                                                </Border>
                                                    <Label Text="{Binding RatingText}" Style="{StaticResource SmallSubtle}"
                                                           VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                                <Label Style="{StaticResource SmallSubtle}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding CountryText}" />
                                                            <Span Text="  ·  " />
                                                            <Span Text="{Binding OwnerText}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <BoxView HeightRequest="1" Color="{StaticResource BrandBorder}" />

                                        <HorizontalStackLayout Spacing="8">
                                            <Button Text="{Binding VerifyButtonText}" Style="{StaticResource ChipButton}"
                                                    BackgroundColor="{StaticResource BrandMint}" TextColor="{StaticResource BrandDark}"
                                                    IsVisible="{Binding CanManage}"
                                                    Command="{Binding ToggleVerifiedCommand, Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Text="{Binding BlockButtonText}" Style="{StaticResource ChipButton}"
                                                    BackgroundColor="{StaticResource BrandPeach}" TextColor="{StaticResource BrandDanger}"
                                                    IsVisible="{Binding CanManage}"
                                                    Command="{Binding ToggleBlockCommand, Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Text="Details" Style="{StaticResource ChipButton}"
                                                    BackgroundColor="White" TextColor="{StaticResource BrandDark}"
                                                    BorderColor="{StaticResource BrandBorder}" BorderWidth="1"
                                                    Command="{Binding OpenShopCommand, Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}}"
                                                    CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- ◀ Page x of y ▶ · Show n -->
                    <controls:PagerView Paging="{Binding ShopsPager}" ScrollTarget="{x:Reference AllShopsTitle}" />
                </VerticalStackLayout>

                <!-- =================================================== -->
                <!-- ================= USERS TAB ======================= -->
                <!-- =================================================== -->
                <VerticalStackLayout Spacing="12" IsVisible="False">
                    <VerticalStackLayout.Triggers>
                        <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding ActiveTab}" Value="Users">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </VerticalStackLayout.Triggers>

                    <VerticalStackLayout Spacing="2" Margin="2,4,0,0">
                        <Label x:Name="UsersTitle" Text="Registered users" Style="{StaticResource SectionTitle}" />
                        <Label Text="Suspend people who abuse Phloem: their shop is hidden with them."
                               Style="{StaticResource SmallSubtle}" />
                    </VerticalStackLayout>

                    <Border BackgroundColor="White" Stroke="{StaticResource BrandBorder}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 12" Padding="12,0" HeightRequest="44">
                        <Entry Text="{Binding UserSearch}" Placeholder="Search people by name" ReturnType="Search"
                               ReturnCommand="{Binding SearchUsersCommand}" VerticalOptions="Center"
                               TextColor="{StaticResource BrandTextDark}" />
                    </Border>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                        <CheckBox IsChecked="{Binding SuspendedOnly}" Color="{StaticResource BrandDark}" />
                        <Label Grid.Column="1" Text="Only suspended people" FontSize="13"
                               TextColor="{StaticResource BrandTextDark}" VerticalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Users}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:AdminUserCard">
                                <Border Style="{StaticResource WhiteCard}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                        <Border StrokeThickness="0" StrokeShape="Ellipse"
                                                WidthRequest="44" HeightRequest="44" VerticalOptions="Start"
                                                BackgroundColor="{StaticResource BrandMintPale}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSuspended}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#FDECEA" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Grid>
                                                <!-- No photo yet: the person icon -->
                                                <Path Data="M12,12 A4,4 0 1 0 12,4 A4,4 0 1 0 12,12 M4,21 C4,16.5 7.5,14 12,14 C16.5,14 20,16.5 20,21"
                                                      Stroke="{StaticResource BrandDark}" StrokeThickness="1.8" StrokeLineCap="Round"
                                                      WidthRequest="22" HeightRequest="22"
                                                      HorizontalOptions="Center" VerticalOptions="Center"
                                                      IsVisible="{Binding HasNoPhoto}" />
                                                <!-- Their profile photo -->
                                                <Image Source="{Binding PhotoUrl}" Aspect="AspectFill"
                                                       IsVisible="{Binding HasPhoto}" />
                                            </Grid>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                                            <Label Text="{Binding FullName}" FontSize="15" FontAttributes="Bold"
                                                   TextColor="{StaticResource BrandTextDark}" />
                                            <Label Text="{Binding Email}" Style="{StaticResource SmallSubtle}" />
                                            <Label Text="{Binding PhoneText}" Style="{StaticResource SmallSubtle}"
                                                   IsVisible="{Binding HasPhone}" />
                                            <Label Text="{Binding ShopText}" Style="{StaticResource SmallSubtle}"
                                                   IsVisible="{Binding HasShop}" />
                                            <Label Style="{StaticResource SmallSubtle}" FontSize="11" Margin="0,2,0,0">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding DetailsText}" />
                                                        <Span Text="  ·  " />
                                                        <Span Text="{Binding RolesText}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <!-- Suspended label -->
                                            <Border BackgroundColor="#FDECEA" StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                                    Padding="8,4" Margin="0,4,0,0" IsVisible="{Binding IsSuspended}">
                                                <Label Text="{Binding SuspensionText}" FontSize="12" FontAttributes="Bold"
                                                       TextColor="{StaticResource BrandDanger}" LineBreakMode="WordWrap" />
                                            </Border>

                                            <HorizontalStackLayout Spacing="8" Margin="0,6,0,0">
                                                <!-- Roles: give or take Admin and the staff roles (not your own Admin) -->
                                                <Button Text="Roles" Style="{StaticResource ChipButton}"
                                                        BackgroundColor="{StaticResource BrandMintPale}" TextColor="{StaticResource BrandDark}"
                                                        Command="{Binding ManageRolesCommand, Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}}"
                                                        CommandParameter="{Binding .}" />
                                                <Button Text="Suspend" Style="{StaticResource ChipButton}"
                                                        BackgroundColor="{StaticResource BrandPeach}" TextColor="{StaticResource BrandDanger}"
                                                        IsVisible="{Binding ShowSuspend}"
                                                        Command="{Binding SuspendCommand, Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}}"
                                                        CommandParameter="{Binding .}" />
                                                <Button Text="Lift suspension" Style="{StaticResource ChipButton}"
                                                        BackgroundColor="{StaticResource BrandMint}" TextColor="{StaticResource BrandDark}"
                                                        IsVisible="{Binding ShowLift}"
                                                        Command="{Binding LiftSuspensionCommand, Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}}"
                                                        CommandParameter="{Binding .}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- ◀ Page x of y ▶ · Show n -->
                    <controls:PagerView Paging="{Binding UsersPager}" ScrollTarget="{x:Reference UsersTitle}" />
                </VerticalStackLayout>

                <!-- =================================================== -->
                <!-- =============== SHIPMENTS TAB ===================== -->
                <!-- =================================================== -->
                <VerticalStackLayout Spacing="12" IsVisible="False">
                    <VerticalStackLayout.Triggers>
                        <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding ActiveTab}" Value="Shipments">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </VerticalStackLayout.Triggers>

                    <Label Text="Cross-border shipments" Style="{StaticResource SectionTitle}" Margin="2,4,0,0" />
                    <Label Text="Parcels customers send between countries (Send Food to UK)."
                           Style="{StaticResource SubtleLabel}" />

                    <!-- Shipping routes -->
                    <Border Style="{StaticResource WhiteCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenShippingRoutesCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource BrandMintPale}" VerticalOptions="Center">
                                <Label Text="🗺" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Shipping routes" FontSize="16" FontAttributes="Bold"
                                       TextColor="{StaticResource BrandTextDark}" />
                                <Label Text="Set up Ghana → UK and others: drop-off hub, prices, switch on or off"
                                       Style="{StaticResource SmallSubtle}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="26" TextColor="{StaticResource BrandTextMuted}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- What can be sent (NEW): the list customers see before booking -->
                    <Border Style="{StaticResource WhiteCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenParcelRulesCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource BrandMintPale}" VerticalOptions="Center">
                                <Label Text="🚫" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="What can be sent" FontSize="16" FontAttributes="Bold"
                                       TextColor="{StaticResource BrandTextDark}" />
                                <Label Text="Items parcels may not contain, or only with a condition"
                                       Style="{StaticResource SmallSubtle}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="26" TextColor="{StaticResource BrandTextMuted}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- All shipments -->
                    <Border Style="{StaticResource WhiteCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenAllShipmentsCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource BrandMintPale}" VerticalOptions="Center">
                                <Label Text="📦" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding TotalShipments, StringFormat='All shipments ({0})'}" FontSize="16"
                                       FontAttributes="Bold" TextColor="{StaticResource BrandTextDark}" />
                                <Label Text="See every parcel, receive and weigh it at the hub, move it along its journey"
                                       Style="{StaticResource SmallSubtle}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="26" TextColor="{StaticResource BrandTextMuted}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
