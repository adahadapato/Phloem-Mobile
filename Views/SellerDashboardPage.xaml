<?xml version="1.0" encoding="UTF-8" ?>
<!--
    SellerDashboardPage: redesigned to match "SellerDashboardPage.xaml / dashboard / Proposed redesign".
    No AppHeaderBar: the green header is built into the page.
    Uses SellerDashboardViewModel: tiles, orders waiting / being prepared / out for delivery and the sales chart
    come from the API; tapping an order opens it (route "shoporder") to accept or decline.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:Phloem.Helpers"
             xmlns:phloem="clr-namespace:Phloem"
             xmlns:vm="clr-namespace:Phloem.ViewModels"
             xmlns:controls="clr-namespace:Phloem.Views.Controls"
             xmlns:models="clr-namespace:Phloem.Models"
             x:DataType="vm:SellerDashboardViewModel"
             x:Class="Phloem.Views.SellerDashboardPage"
             x:Name="RootPage"
             Shell.NavBarIsVisible="False"
             Title="Seller Dashboard">

    <!-- Keeps the screen on while this page is open (My account → Keep screen on) -->
    <ContentPage.Behaviors>
        <helpers:KeepScreenAwakeBehavior />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <!-- White stat tile -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="Padding" Value="14,14" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="Black" Opacity="0.06" Radius="10" Offset="0,3" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatNumberLabel" TargetType="Label">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
        </Style>
        <Style x:Key="StatCaptionLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextMuted}" />
        </Style>
        <!-- One order card (waiting / being prepared / out for delivery): tap → the order's page -->
        <DataTemplate x:Key="ShopOrderTemplate" x:DataType="models:ShopOrderCard">
            <Border BackgroundColor="White" Stroke="{StaticResource BrandBorder}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 14" Padding="12,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding OpenOrderCommand, Source={RelativeSource AncestorType={x:Type vm:SellerDashboardViewModel}}}"
                        CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="2">
                    <Label Text="{Binding CustomerName}" FontSize="15" FontAttributes="Bold"
                           TextColor="{StaticResource BrandTextDark}" LineBreakMode="TailTruncation" />
                    <Label Grid.Column="1" Text="{Binding TotalText}" Style="{StaticResource PriceLabel}" />
                    <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ItemsSummary}" FontSize="13"
                           TextColor="{StaticResource BrandTextDark}" LineBreakMode="TailTruncation" MaxLines="2" />
                    <Label Grid.Row="2" Text="{Binding WhenText}" FontSize="12"
                           TextColor="{StaticResource BrandTextMuted}" LineBreakMode="TailTruncation" />
                    <Label Grid.Row="2" Grid.Column="1" Text="Open  ›" FontSize="12" FontAttributes="Bold"
                           TextColor="{StaticResource BrandGreen}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Small − / + price buttons -->
        <Style x:Key="TinyStepButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="WidthRequest" Value="30" />
            <Setter Property="HeightRequest" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderWidth" Value="0" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ============ GREEN HEADER ============ -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource BrandDark}" HeightRequest="72">
            <Ellipse Stroke="#1AFFFFFF" StrokeThickness="10"
                     WidthRequest="320" HeightRequest="320"
                     HorizontalOptions="Start" VerticalOptions="Start"
                     Margin="-60,-30,0,0" InputTransparent="True" />

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="18,0,16,0">
                <Grid WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                    <Path Data="M2,5 L22,5 M2,12 L22,12 M2,19 L22,19"
                          Stroke="White" StrokeThickness="2.4" StrokeLineCap="Round"
                          WidthRequest="24" HeightRequest="24"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMenuTapped" />
                    </Grid.GestureRecognizers>
                </Grid>

                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{x:Static phloem:AppNav.GoHomeCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Image Source="header_logo.png" WidthRequest="34" HeightRequest="34" />
                    <Label Text="Phloem" TextColor="White" FontSize="22" FontAttributes="Bold"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border Grid.Column="2" BackgroundColor="White" StrokeThickness="0"
                        StrokeShape="RoundRectangle 16" Padding="10,3" HeightRequest="32"
                        VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="5">
                        <Label x:Name="FlagLabel" Text="🌍" FontSize="18" VerticalOptions="Center" />
                        <Path Data="M2,4 L6,8 L10,4" Stroke="{StaticResource BrandTextDark}"
                              StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round"
                              WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsLoading}" Command="{Binding RefreshCommand}"
                     RefreshColor="{StaticResource BrandDark}">
        <ScrollView>
            <VerticalStackLayout Padding="16,18,16,28" Spacing="14"
                                 MaximumWidthRequest="700" HorizontalOptions="Fill">

                <!-- ============ TITLE ============ -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="2,0,0,2">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Seller dashboard" FontSize="26" FontAttributes="Bold"
                               TextColor="{StaticResource BrandTextDark}" />
                        <Label Text="{Binding Greeting}" Style="{StaticResource SubtleLabel}" FontSize="13" />
                    </VerticalStackLayout>

                    <!-- NEW: Shop settings (business name, email, phone) -->
                    <Border Grid.Column="1" BackgroundColor="White" Stroke="{StaticResource BrandBorder}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 18" Padding="12,0" HeightRequest="36" VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="6">
                            <Path Data="M12,9 A3,3 0 1 0 12.01,9 M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M4.9,19.1 L7,17 M17,7 L19.1,4.9"
                                  Stroke="{StaticResource BrandDark}" StrokeThickness="1.8" StrokeLineCap="Round"
                                  WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            <Label Text="Shop settings" FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource BrandDark}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShopSettingsCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <!-- ============ STATS (2 × 2) ============ -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                    <!-- Balance (mint) -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource StatCard}"
                            BackgroundColor="{StaticResource BrandMintPale}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding BalanceText}"
                                   Style="{StaticResource StatNumberLabel}" TextColor="{StaticResource BrandGreen}" />
                            <Label Text="Available balance" Style="{StaticResource StatCaptionLabel}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Total orders -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource StatCard}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding TotalOrdersText}" Style="{StaticResource StatNumberLabel}" />
                            <Label Text="Total orders" Style="{StaticResource StatCaptionLabel}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Orders waiting to be accepted -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource StatCard}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding WaitingCountText}" Style="{StaticResource StatNumberLabel}" />
                            <Label Text="Orders waiting" Style="{StaticResource StatCaptionLabel}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Store rating -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StatCard}">
                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource StatNumberLabel}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding RatingText}" />
                                        <Span Text="  ★" TextColor="{StaticResource BrandStar}" FontSize="20" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Text="Store rating" Style="{StaticResource StatCaptionLabel}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Why the dashboard couldn't load (no shop, no internet…) -->
                <Border BackgroundColor="{StaticResource BrandPeach}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 12" Padding="14,10" IsVisible="{Binding HasMessage}">
                    <Label Text="{Binding Message}" FontSize="13" TextColor="{StaticResource BrandTextDark}" />
                </Border>

                <!-- ============ ORDERS WAITING ============ -->
                <Label x:Name="WaitingTitleLabel" Text="{Binding WaitingTitle}" Style="{StaticResource SectionTitle}" Margin="2,10,0,0" />
                <Label Text="Open an order to see what the customer ordered, then accept or decline it."
                       Style="{StaticResource SubtleLabel}" FontSize="12" Margin="2,-8,0,0"
                       IsVisible="{Binding HasNoWaitingOrders, Converter={StaticResource InvertedBoolConverter}}" />

                <Border BackgroundColor="{StaticResource BrandMintPale}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 14" Padding="16,18" IsVisible="{Binding HasNoWaitingOrders}">
                    <Label Text="No orders waiting right now." FontSize="14" FontAttributes="Bold"
                           TextColor="{StaticResource BrandDark}" HorizontalOptions="Center" />
                </Border>

                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding WaitingOrders}"
                                     BindableLayout.ItemTemplate="{StaticResource ShopOrderTemplate}" />

                <!-- ◀ Page x of y ▶ · Show n -->
                <controls:PagerView Paging="{Binding WaitingPager}" ScrollTarget="{x:Reference WaitingTitleLabel}" />

                <!-- ============ BEING PREPARED ============ -->
                <Label x:Name="PreparingTitleLabel" Text="{Binding PreparingTitle}" Style="{StaticResource SectionTitle}" Margin="2,10,0,0"
                       IsVisible="{Binding HasPreparingOrders}" />
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding PreparingOrders}"
                                     BindableLayout.ItemTemplate="{StaticResource ShopOrderTemplate}"
                                     IsVisible="{Binding HasPreparingOrders}" />

                <!-- ◀ Page x of y ▶ · Show n -->
                <controls:PagerView Paging="{Binding PreparingPager}" ScrollTarget="{x:Reference PreparingTitleLabel}" />

                <!-- ============ OUT FOR DELIVERY ============ -->
                <Label x:Name="OutForDeliveryTitleLabel" Text="{Binding OutForDeliveryTitle}" Style="{StaticResource SectionTitle}" Margin="2,10,0,0"
                       IsVisible="{Binding HasOutForDeliveryOrders}" />
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding OutForDeliveryOrders}"
                                     BindableLayout.ItemTemplate="{StaticResource ShopOrderTemplate}"
                                     IsVisible="{Binding HasOutForDeliveryOrders}" />

                <!-- ◀ Page x of y ▶ · Show n -->
                <controls:PagerView Paging="{Binding OutForDeliveryPager}" ScrollTarget="{x:Reference OutForDeliveryTitleLabel}" />

                <!-- ============ SALES OVERVIEW ============ -->
                <Label Text="Sales overview" Style="{StaticResource SectionTitle}" Margin="2,10,0,0" />

                <Border Style="{StaticResource StatCard}" Padding="10,16,10,10">
                    <FlexLayout BindableLayout.ItemsSource="{Binding WeeklySales}"
                                JustifyContent="SpaceEvenly" AlignItems="End" HeightRequest="96">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SalesBar">
                                <VerticalStackLayout Spacing="6" VerticalOptions="End">
                                    <Border WidthRequest="26" HeightRequest="{Binding BarHeight}"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 6"
                                            BackgroundColor="{StaticResource BrandDark}"
                                            HorizontalOptions="Center">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsWeekend}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource BrandOrange}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                    </Border>
                                    <Label Text="{Binding Day}" FontSize="11" FontAttributes="Bold"
                                           TextColor="{StaticResource BrandTextMuted}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </Border>

                <!-- ============ MY DISHES ============ -->
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="2,10,0,0">
                    <Label x:Name="MyDishesTitle" Text="My dishes" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="View all  →" Style="{StaticResource LinkLabel}"
                           TextColor="{StaticResource BrandDark}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ViewAllDishesCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Button Grid.Column="2" Text="+ Add dish" Command="{Binding AddDishCommand}"
                            BackgroundColor="{StaticResource BrandDark}" TextColor="White"
                            FontAttributes="Bold" FontSize="13" CornerRadius="16"
                            HeightRequest="34" Padding="14,0" VerticalOptions="Center" />
                </Grid>

                <!-- Dishes whose allowed price range changed -->
                <Border BackgroundColor="{StaticResource BrandPeach}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 12" Padding="14,10" IsVisible="{Binding HasPriceUpdates}">
                    <Label Text="{Binding PriceUpdateText}" FontSize="13" TextColor="{StaticResource BrandTextDark}" />
                </Border>

                <!-- No dishes yet -->
                <Border BackgroundColor="{StaticResource BrandMintPale}" Stroke="{StaticResource BrandMint}"
                        StrokeThickness="1.5" StrokeDashArray="5,4" StrokeShape="RoundRectangle 16"
                        Padding="16,20" IsVisible="{Binding HasNoDishes}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddDishCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="📷" FontSize="28" HorizontalOptions="Center" />
                        <Label Text="Add your first dish" FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource BrandDark}" HorizontalOptions="Center" />
                        <Label Text="Pick the dish, add a photo and set your price" FontSize="12"
                               TextColor="{StaticResource BrandTextMuted}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Dish rows: tap to edit; − / + still nudge the price -->
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding MyDishes}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Dish">
                            <Border BackgroundColor="White" Stroke="{StaticResource BrandBorder}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14" Padding="8">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.EditDishCommand, Source={x:Reference RootPage}}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>

                                    <!-- Photo -->
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                            WidthRequest="56" HeightRequest="48"
                                            BackgroundColor="{StaticResource BrandMintPale}">
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold"
                                               TextColor="{StaticResource BrandTextDark}" LineBreakMode="TailTruncation" />
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="Edit ›" FontSize="11" FontAttributes="Bold"
                                                   TextColor="{StaticResource BrandGreen}" />
                                            <Label Text="· Hidden" FontSize="11" FontAttributes="Bold"
                                                   TextColor="{StaticResource BrandDanger}"
                                                   IsVisible="{Binding IsAvailable, Converter={StaticResource InvertedBoolConverter}}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2" Text="{Binding PriceText}"
                                           Style="{StaticResource PriceLabel}" VerticalOptions="Center" />
                                    <HorizontalStackLayout Grid.Column="3" Spacing="0" VerticalOptions="Center">
                                        <Button Text="−" Style="{StaticResource TinyStepButton}"
                                                Command="{Binding BindingContext.DecreasePriceCommand, Source={x:Reference RootPage}}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="+" Style="{StaticResource TinyStepButton}"
                                                Command="{Binding BindingContext.IncreasePriceCommand, Source={x:Reference RootPage}}"
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- ◀ Page x of y ▶ · Show n -->
                <controls:PagerView Paging="{Binding DishesPager}" ScrollTarget="{x:Reference MyDishesTitle}" />

            </VerticalStackLayout>
        </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
