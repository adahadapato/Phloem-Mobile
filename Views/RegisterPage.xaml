<?xml version="1.0" encoding="UTF-8" ?>
<!--
    RegisterPage: redesigned to match "RegisterPage.xaml / register / Proposed redesign".
    No AppHeaderBar: the green header is built into the page.
    Bound to RegisterViewModel: first and last name, email, password, phone, optional home address
    (street, town or city, region or postcode), terms, and IsSeller (Buyer | Seller choice).
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:phloem="clr-namespace:Phloem"
             xmlns:vm="clr-namespace:Phloem.ViewModels"
             xmlns:controls="clr-namespace:Phloem.Views.Controls"
             x:DataType="vm:RegisterViewModel"
             x:Class="Phloem.Views.RegisterPage"
             Shell.NavBarIsVisible="False"
             Title="Sign Up">

    <ContentPage.Resources>
        <!-- Field label above each input -->
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>
        <!-- Rounded input box -->
        <Style x:Key="FieldBox" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="{StaticResource BrandBorder}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HeightRequest" Value="48" />
        </Style>
        <Style x:Key="FieldEntry" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextDark}" />
            <Setter Property="PlaceholderColor" Value="{StaticResource BrandTextMuted}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ============ GREEN HEADER ============ -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource BrandDark}" HeightRequest="72">
            <Ellipse Stroke="#1AFFFFFF" StrokeThickness="10"
                     WidthRequest="320" HeightRequest="320"
                     HorizontalOptions="Start" VerticalOptions="Start"
                     Margin="-60,-30,0,0" InputTransparent="True" />

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="18,0,16,0">
                <!-- Menu (opens the side menu) -->
                <Grid WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                    <Path Data="M2,5 L22,5 M2,12 L22,12 M2,19 L22,19"
                          Stroke="White" StrokeThickness="2.4" StrokeLineCap="Round"
                          WidthRequest="24" HeightRequest="24"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMenuTapped" />
                    </Grid.GestureRecognizers>
                </Grid>

                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{x:Static phloem:AppNav.GoHomeCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Image Source="header_logo.png" WidthRequest="34" HeightRequest="34" />
                    <Label Text="Phloem" TextColor="White" FontSize="22" FontAttributes="Bold"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- Flag pill (country chosen on Home) -->
                <Border Grid.Column="2" BackgroundColor="White" StrokeThickness="0"
                        StrokeShape="RoundRectangle 16" Padding="10,3" HeightRequest="32"
                        VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="5">
                        <Label x:Name="FlagLabel" Text="🌍" FontSize="18" VerticalOptions="Center" />
                        <Path Data="M2,4 L6,8 L10,4" Stroke="{StaticResource BrandTextDark}"
                              StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round"
                              WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,18,16,28" Spacing="14"
                                 MaximumWidthRequest="560" HorizontalOptions="Fill">

                <!-- ============ TITLE ============ -->
                <VerticalStackLayout Spacing="2" Margin="2,0,0,0">
                    <Label Text="Create your account" FontSize="26" FontAttributes="Bold"
                           TextColor="{StaticResource BrandTextDark}" />
                    <Label Text="Join food lovers across Africa and the UK"
                           Style="{StaticResource SubtleLabel}" FontSize="13" />
                </VerticalStackLayout>

                <!-- ============ ACCOUNT TYPE: Buyer | Seller ============ -->
                <Border BackgroundColor="{StaticResource BrandMintPale}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 14" Padding="4" HeightRequest="50">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="4">

                        <!-- Buyer -->
                        <Border x:Name="BuyerOption" StrokeThickness="0" StrokeShape="RoundRectangle 11"
                                BackgroundColor="{StaticResource BrandDark}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSeller}" Value="True">
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBuyerTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="🧺  I want to buy" FontSize="14" FontAttributes="Bold" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSeller}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource BrandTextMuted}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>

                        <!-- Seller -->
                        <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 11"
                                BackgroundColor="Transparent">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSeller}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource BrandOrange}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSellerTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="🏪  I want to sell" FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource BrandTextMuted}"
                                   HorizontalOptions="Center" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSeller}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </Grid>
                </Border>

                <!-- Shown only when Seller is chosen -->
                <Label IsVisible="{Binding IsSeller}" Margin="4,-4,4,0" FontSize="12"
                       TextColor="{StaticResource BrandTextMuted}"
                       Text="After creating your account you'll set up your shop: logo, business name and contact details." />

                <!-- ============ FORM CARD ============ -->
                <Border BackgroundColor="White" StrokeThickness="0"
                        StrokeShape="RoundRectangle 18" Padding="16,18">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.06" Radius="12" Offset="0,3" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">

                        <!-- First and last name side by side (the API stores them separately) -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout>
                                <Label Text="First name" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource FieldBox}">
                                    <Entry Placeholder="Ama" Text="{Binding FirstName}"
                                           Style="{StaticResource FieldEntry}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Last name" Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource FieldBox}">
                                    <Entry Placeholder="Mensah" Text="{Binding LastName}"
                                           Style="{StaticResource FieldEntry}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout>
                            <Label Text="Email address" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBox}">
                                <Entry Placeholder="you@example.com" Keyboard="Email" Text="{Binding Email}"
                                       Style="{StaticResource FieldEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="Password" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBox}">
                                <Entry Placeholder="Create a strong password" IsPassword="True" Text="{Binding Password}"
                                       Style="{StaticResource FieldEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="Phone number (optional)" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBox}">
                                <Entry Placeholder="+44 7xxx xxx xxx" Keyboard="Telephone" Text="{Binding PhoneNumber}"
                                       Style="{StaticResource FieldEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Home address: optional now, needed later to open a shop or send a parcel.
                             When given it also becomes the "Home" delivery address. -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Home address (optional)" Style="{StaticResource FieldLabel}" />
                            <Label Text="You can add it later. It's needed to open a shop or send a parcel."
                                   FontSize="12" TextColor="{StaticResource BrandTextMuted}" Margin="2,-4,0,2" />
                            <Border Style="{StaticResource FieldBox}">
                                <Entry Placeholder="House number and street" Text="{Binding AddressLine1}"
                                       Style="{StaticResource FieldEntry}" />
                            </Border>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Border Style="{StaticResource FieldBox}">
                                    <Entry Placeholder="Town or city" Text="{Binding City}"
                                           Style="{StaticResource FieldEntry}" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource FieldBox}">
                                    <Entry Placeholder="Region or postcode" Text="{Binding RegionOrPostcode}"
                                           Style="{StaticResource FieldEntry}" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Terms -->
                        <HorizontalStackLayout Spacing="4" Margin="-6,0,0,0">
                            <CheckBox IsChecked="{Binding AgreedToTerms}" Color="{StaticResource BrandGreen}"
                                      VerticalOptions="Center" />
                            <!-- The two names open the texts (from the API) on top of this page -->
                            <Label FontSize="13" TextColor="{StaticResource BrandTextMuted}" VerticalOptions="Center"
                                   LineBreakMode="WordWrap">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="I agree to the " />
                                        <Span Text="Terms &amp; Conditions" TextColor="{StaticResource BrandGreen}"
                                              FontAttributes="Bold" TextDecorations="Underline">
                                            <Span.GestureRecognizers>
                                                <TapGestureRecognizer Command="{x:Static phloem:AppNav.OpenTermsCommand}" />
                                            </Span.GestureRecognizers>
                                        </Span>
                                        <Span Text=" and the " />
                                        <Span Text="Privacy Policy" TextColor="{StaticResource BrandGreen}"
                                              FontAttributes="Bold" TextDecorations="Underline">
                                            <Span.GestureRecognizers>
                                                <TapGestureRecognizer Command="{x:Static phloem:AppNav.OpenPrivacyCommand}" />
                                            </Span.GestureRecognizers>
                                        </Span>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ SUBMIT ============ -->
                <Button Text="Create account" Command="{Binding SignUpCommand}"
                        BackgroundColor="{StaticResource BrandDark}" TextColor="White"
                        FontAttributes="Bold" FontSize="16" CornerRadius="12" HeightRequest="52">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsSeller}" Value="True">
                            <Setter Property="Text" Value="Create account &amp; set up shop" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <!-- Or: Continue with Google (only when the API has Google switched on) -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsGoogleAvailable}">
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                        <BoxView HeightRequest="1" Color="{StaticResource BrandBorder}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="or" FontSize="13"
                               TextColor="{StaticResource BrandTextMuted}" VerticalOptions="Center" />
                        <BoxView Grid.Column="2" HeightRequest="1" Color="{StaticResource BrandBorder}"
                                 VerticalOptions="Center" />
                    </Grid>
                    <!-- Google's rules: white button, their official "G" logo, "Continue with Google".
                         Add the logo from Google's branding kit as Resources/Images/google_g.png, then
                         add ImageSource="google_g.png" ContentLayout="Left,10" to this button. -->
                    <Button Text="Continue with Google" Command="{Binding ContinueWithGoogleCommand}"
                            BackgroundColor="White" TextColor="#1F1F1F"
                            BorderColor="#747775" BorderWidth="1"
                            FontAttributes="Bold" FontSize="15" CornerRadius="12" HeightRequest="52" />
                    <Label FontSize="12" TextColor="{StaticResource BrandTextMuted}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="By continuing with Google you agree to the " />
                                <Span Text="Terms &amp; Conditions" TextColor="{StaticResource BrandGreen}"
                                      FontAttributes="Bold" TextDecorations="Underline">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Command="{x:Static phloem:AppNav.OpenTermsCommand}" />
                                    </Span.GestureRecognizers>
                                </Span>
                                <Span Text=" and the " />
                                <Span Text="Privacy Policy" TextColor="{StaticResource BrandGreen}"
                                      FontAttributes="Bold" TextDecorations="Underline">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Command="{x:Static phloem:AppNav.OpenPrivacyCommand}" />
                                    </Span.GestureRecognizers>
                                </Span>
                                <Span Text="." />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>

                <controls:StatusBanner Message="{Binding StatusMessage}" IsError="{Binding IsError}" />

                <!-- Already registered -->
                <Label HorizontalOptions="Center" FontSize="13" Margin="0,2,0,0">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Already have an account? " TextColor="{StaticResource BrandTextMuted}" />
                            <Span Text="Log in" TextColor="{StaticResource BrandGreen}" FontAttributes="Bold">
                                <Span.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLogInTapped" />
                                </Span.GestureRecognizers>
                            </Span>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
