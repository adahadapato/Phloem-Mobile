<?xml version="1.0" encoding="UTF-8" ?>
<!--
    OrderDetailsPage (NEW): opened by tapping an order number on the Orders page (route "orderdetails").
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:phloem="clr-namespace:Phloem"
             xmlns:vm="clr-namespace:Phloem.ViewModels"
             xmlns:services="clr-namespace:Phloem.Services"
             x:DataType="vm:OrderDetailsViewModel"
             x:Class="Phloem.Views.OrderDetailsPage"
             Shell.NavBarIsVisible="False"
             Title="Order details">

    <ContentPage.Resources>
        <Style x:Key="WhiteCard" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="Black" Opacity="0.06" Radius="10" Offset="0,3" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallMuted" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource BrandTextMuted}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ============ GREEN HEADER (back arrow) ============ -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource BrandDark}" HeightRequest="72">
            <Ellipse Stroke="#1AFFFFFF" StrokeThickness="10"
                     WidthRequest="320" HeightRequest="320"
                     HorizontalOptions="Start" VerticalOptions="Start"
                     Margin="-60,-30,0,0" InputTransparent="True" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="14,0,16,0">
                <Grid WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                    <Path Data="M15,5 L8,12 L15,19" Stroke="White" StrokeThickness="2.6"
                          StrokeLineCap="Round" StrokeLineJoin="Round"
                          WidthRequest="24" HeightRequest="24"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Grid.GestureRecognizers>
                </Grid>
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{x:Static phloem:AppNav.GoHomeCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Image Source="header_logo.png" WidthRequest="34" HeightRequest="34" />
                    <Label Text="Phloem" TextColor="White" FontSize="22" FontAttributes="Bold"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,18,16,28" Spacing="12"
                                 MaximumWidthRequest="560" HorizontalOptions="Fill">

                <!-- ============ TITLE ============ -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="2,0,0,4">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Order details" FontSize="26" FontAttributes="Bold"
                               TextColor="{StaticResource BrandTextDark}" />
                        <Label FontSize="13" TextColor="{StaticResource BrandTextMuted}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Order.OrderNumber}" FontAttributes="Bold"
                                          TextColor="{StaticResource BrandDark}" />
                                    <Span Text="  ·  " />
                                    <Span Text="{Binding Order.PlacedAtText}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                    <!-- Status chip -->
                    <Border Grid.Column="1" BackgroundColor="{StaticResource BrandMintPale}" StrokeThickness="0"
                            StrokeShape="RoundRectangle 10" Padding="10,4" VerticalOptions="Center">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Order.IsCancelled}" Value="True">
                                <Setter Property="BackgroundColor" Value="#FDECEA" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding Order.StatusText}" FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource BrandDark}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Order.IsCancelled}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource BrandDanger}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </Grid>

                <!-- ============ CANCELLED BANNER ============ -->
                <Border BackgroundColor="#FDECEA" Stroke="#F5C6C0" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14" Padding="14,12" IsVisible="{Binding Order.IsCancelled}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="This order was cancelled" FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource BrandDanger}" />
                        <!-- The shop declined it: their reason -->
                        <Label Text="{Binding Order.DeclineText}" FontSize="13" Margin="0,2,0,2"
                               TextColor="{StaticResource BrandTextDark}" IsVisible="{Binding Order.WasDeclined}" />
                        <Label FontSize="12" TextColor="{StaticResource BrandTextMuted}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Order.CancelledAt, StringFormat='Cancelled {0:d MMM, HH:mm}'}" />
                                    <Span Text=" · your payment will be refunded." />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ PROGRESS TRACKER ============ -->
                <Border Style="{StaticResource WhiteCard}" Padding="16,14"
                        IsVisible="{Binding Order.IsCancelled, Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout Spacing="0">
                        <!-- Step 1: placed (always done) -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Border StrokeThickness="0" StrokeShape="Ellipse" WidthRequest="22" HeightRequest="22"
                                        BackgroundColor="{StaticResource BrandDark}">
                                    <Label Text="✓" FontSize="12" FontAttributes="Bold" TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <BoxView WidthRequest="2" HeightRequest="26" Color="{StaticResource BrandDark}"
                                         HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="Order placed" FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource BrandTextDark}" />
                                <Label Text="{Binding Order.PlacedAtText}" Style="{StaticResource SmallMuted}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Step 2: being prepared (done once the cancel window has passed) -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Border StrokeThickness="2" Stroke="{StaticResource BrandBorder}" StrokeShape="Ellipse"
                                        WidthRequest="22" HeightRequest="22" BackgroundColor="White">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Order.IsPreparing}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource BrandDark}" />
                                            <Setter Property="Stroke" Value="{StaticResource BrandDark}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="✓" FontSize="12" FontAttributes="Bold" TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           IsVisible="{Binding Order.IsPreparing}" />
                                </Border>
                                <BoxView WidthRequest="2" HeightRequest="26" Color="{StaticResource BrandBorder}"
                                         HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="Being prepared" FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource BrandTextDark}" />
                                <Label Text="The vendor is cooking your order" Style="{StaticResource SmallMuted}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Step 3: on its way (upcoming) -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border StrokeThickness="2" Stroke="{StaticResource BrandBorder}" StrokeShape="Ellipse"
                                    WidthRequest="22" HeightRequest="22" BackgroundColor="White" VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="{Binding Order.ThirdStepTitle}" FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource BrandTextMuted}" />
                                <Label Text="We'll let you know when it's on the move" Style="{StaticResource SmallMuted}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ ITEMS ============ -->
                <Grid ColumnDefinitions="*,Auto" Margin="2,8,0,0">
                    <Label Text="Items" Style="{StaticResource SectionTitle}" FontSize="17" />
                    <Label Grid.Column="1" Text="{Binding Order.ItemCount, StringFormat='{0} item(s)'}"
                           FontSize="12" FontAttributes="Bold" TextColor="{StaticResource BrandDark}"
                           VerticalOptions="Center" />
                </Grid>

                <!-- "Loading the order…" while the dishes come from the server, or why they couldn't -->
                <Label Text="{Binding Message}" FontSize="13" TextColor="{StaticResource BrandTextMuted}"
                       HorizontalTextAlignment="Center">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding Message}" Value="">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Order.Lines}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="services:OrderLine">
                            <Border Style="{StaticResource WhiteCard}" Padding="10">
                                <Grid ColumnDefinitions="68,*,Auto" ColumnSpacing="12">
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                            WidthRequest="68" HeightRequest="52">
                                        <Image Source="{Binding Dish.ImageUrl}" Aspect="AspectFill" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Dish.Name}" FontSize="15" FontAttributes="Bold"
                                               TextColor="{StaticResource BrandTextDark}" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Dish.VendorName}" Style="{StaticResource SmallMuted}"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding LineTotalText}" Style="{StaticResource PriceLabel}"
                                               HorizontalOptions="End" />
                                        <Label Text="{Binding QuantityText}" FontSize="12" FontAttributes="Bold"
                                               TextColor="{StaticResource BrandTextMuted}" HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- ============ DELIVERY + PAYMENT ============ -->
                <Border Style="{StaticResource WhiteCard}" Margin="0,6,0,0">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Path Data="M12,22 C12,22 4,14.5 4,9 A8,8 0 0 1 20,9 C20,14.5 12,22 12,22 Z M9,9 A3,3 0 1 0 15,9 A3,3 0 1 0 9,9"
                                  Stroke="{StaticResource BrandDark}" StrokeThickness="1.8"
                                  WidthRequest="22" HeightRequest="22" VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Delivery address" Style="{StaticResource SmallMuted}" />
                                <Label Text="{Binding Order.DeliveryAddress}" FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource BrandTextDark}" LineBreakMode="WordWrap" />

                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource BrandBorder}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Path Data="M2,6 L22,6 L22,18 L2,18 Z M2,10 L22,10 M5,15 L9,15"
                                  Stroke="{StaticResource BrandDark}" StrokeThickness="1.8" StrokeLineJoin="Round"
                                  WidthRequest="22" HeightRequest="22" VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Payment" Style="{StaticResource SmallMuted}" />
                                <Label Text="{Binding Order.PaymentMethod}" FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource BrandTextDark}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ TOTALS ============ -->
                <Border BackgroundColor="{StaticResource BrandMintPale}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 14" Padding="14,12">
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Subtotal" FontSize="13" TextColor="{StaticResource BrandTextMuted}" />
                            <Label Grid.Column="1" Text="{Binding Order.SubtotalText}" FontSize="13"
                                   TextColor="{StaticResource BrandTextMuted}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Delivery fee" FontSize="13" TextColor="{StaticResource BrandTextMuted}" />
                            <Label Grid.Column="1" Text="{Binding Order.DeliveryFeeText}" FontSize="13"
                                   TextColor="{StaticResource BrandTextMuted}" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource BrandMint}" Margin="0,4" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Total" FontSize="17" FontAttributes="Bold"
                                   TextColor="{StaticResource BrandDark}" />
                            <Label Grid.Column="1" Text="{Binding Order.TotalText}" FontSize="17"
                                   FontAttributes="Bold" TextColor="{StaticResource BrandDark}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Order.IsCancelled}" Value="True">
                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                        <Setter Property="TextColor" Value="{StaticResource BrandTextMuted}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ ACTIONS ============ -->
                <Button Text="↻  Buy again" Command="{Binding BuyAgainCommand}"
                        BackgroundColor="{StaticResource BrandDark}" TextColor="White"
                        FontAttributes="Bold" FontSize="16" CornerRadius="12" HeightRequest="52"
                        Margin="0,6,0,0" />
                <Button Text="Cancel order" Command="{Binding CancelOrderCommand}"
                        IsVisible="{Binding Order.CanCancel}"
                        BackgroundColor="White" TextColor="{StaticResource BrandDanger}"
                        BorderColor="{StaticResource BrandDanger}" BorderWidth="1.5"
                        FontAttributes="Bold" FontSize="15" CornerRadius="12" HeightRequest="50" />
                <Label Text="You can cancel within 30 minutes of ordering." Style="{StaticResource SmallMuted}"
                       HorizontalOptions="Center" IsVisible="{Binding Order.CanCancel}" />
                <!-- Need help? → Help & support -->
                <Label FontSize="13" TextColor="{StaticResource BrandTextMuted}"
                       HorizontalTextAlignment="Center" Margin="8,4,8,0">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="💬 Something wrong with this order? " />
                            <Span Text="Help &amp; support ›" TextColor="{StaticResource BrandGreen}" FontAttributes="Bold">
                                <Span.GestureRecognizers>
                                    <TapGestureRecognizer Command="{x:Static phloem:AppNav.OpenOrdersHelpCommand}" />
                                </Span.GestureRecognizers>
                            </Span>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
